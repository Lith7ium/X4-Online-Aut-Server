<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in, registry-backed NPC sector-change reacquisition experiment.
     Never auto-runs: every cue requires a correlated UI-triggered event with an
     active X4AuthorityShipRegistry epoch and matching ship index. -->
<mdscript name="X4AuthorityNpcReacquisition" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <actions>
    <set_value name="$prepared" exact="false"/>
    <set_value name="$prepared_request" exact="''"/>
    <set_value name="$prepared_index" exact="0"/>
    <set_value name="$prepared_ship" exact="null"/>
    <set_value name="$prepared_prev_sector" exact="''"/>
    <set_value name="$prepared_target_sector" exact="null"/>
    <set_value name="$prepared_target_macro" exact="''"/>
    <set_value name="$owned_wait" exact="null"/>
    <set_value name="$owned_ship" exact="null"/>
   </actions>
  </cue>

  <cue name="Prepare" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'Prepare'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardShip"/>
    <do_if value="$valid and not State.$prepared and $r.$previous_sector? and $r.$target_sector?">
     <find_sector name="$targets" macro="macro.{$r.$target_sector}" multiple="true" required="false"/>
     <do_if value="@$ship.sector.macro.id == $r.$previous_sector and @$targets.count == 1 and @$targets.{1}.isclass.sector and $targets.{1} != $ship.sector">
      <set_value name="State.$prepared" exact="true"/>
      <set_value name="State.$prepared_request" exact="$r.$request_id"/>
      <set_value name="State.$prepared_index" exact="$r.$index"/>
      <set_value name="State.$prepared_ship" exact="$ship"/>
      <set_value name="State.$prepared_prev_sector" exact="$r.$previous_sector"/>
      <set_value name="State.$prepared_target_sector" exact="$targets.{1}"/>
      <set_value name="State.$prepared_target_macro" exact="$r.$target_sector"/>
      <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Prepared|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$ship.sector,$ship.parent,$ship.sector.macro.id,$targets.{1}]"/>
     </do_if>
     <do_else>
      <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|prepare_sector'.[@$r.$request_id]"/>
     </do_else>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|prepare_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="Cancel" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'Cancel'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardShip"/>
    <do_if value="$valid and State.$prepared and $r.$prepared_request? and $r.$prepared_request == State.$prepared_request and $ship == State.$prepared_ship and $r.$index == State.$prepared_index">
     <set_value name="State.$prepared" exact="false"/>
     <set_value name="State.$prepared_request" exact="''"/>
     <set_value name="State.$prepared_index" exact="0"/>
     <set_value name="State.$prepared_ship" exact="null"/>
     <set_value name="State.$prepared_prev_sector" exact="''"/>
     <set_value name="State.$prepared_target_sector" exact="null"/>
     <set_value name="State.$prepared_target_macro" exact="''"/>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Canceled|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$ship.sector,$ship.parent,$ship.sector.macro.id]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|cancel_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="Align" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'Align'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardShip"/>
    <do_if value="$valid and State.$prepared and $r.$prepared_request? and $r.$prepared_request == State.$prepared_request and $ship == State.$prepared_ship and $r.$index == State.$prepared_index and $r.$target_sector? and $r.$target_sector == State.$prepared_target_macro and $r.$x? and $r.$y? and $r.$z? and $r.$yaw? and $r.$pitch? and $r.$roll?">
     <set_value name="$target" exact="State.$prepared_target_sector"/>
     <!-- Retire any previously owned motion controller order before moving the actor. -->
     <do_if value="@State.$owned_ship == $ship">
      <set_object_velocity object="$ship" constantvel="false"/>
      <do_if value="@State.$owned_wait.exists">
       <cancel_order order="State.$owned_wait"/>
      </do_if>
      <set_value name="State.$owned_wait" exact="null"/>
     </do_if>
     <set_value name="State.$prepared" exact="false"/>
     <set_value name="State.$prepared_request" exact="''"/>
     <set_value name="State.$prepared_index" exact="0"/>
     <set_value name="State.$prepared_ship" exact="null"/>
     <set_value name="State.$prepared_prev_sector" exact="''"/>
     <set_value name="State.$prepared_target_sector" exact="null"/>
     <set_value name="State.$prepared_target_macro" exact="''"/>
     <warp object="$ship" sector="$target">
      <position x="$r.$x * 1m" y="$r.$y * 1m" z="$r.$z * 1m"/>
      <rotation yaw="$r.$yaw * 1deg" pitch="$r.$pitch * 1deg" roll="$r.$roll * 1deg"/>
     </warp>
     <create_order object="$ship" id="'Wait'" immediate="true" name="State.$owned_wait">
      <param name="timeout" value="60s"/>
      <param name="skipalignment" value="true"/>
      <param name="fidget" value="false"/>
      <param name="noattackresponse" value="true"/>
     </create_order>
     <set_value name="State.$owned_ship" exact="$ship"/>
     <do_if value="$r.$vx? and $r.$vy? and $r.$vz?">
      <set_object_velocity object="$ship" constantvel="true">
       <linear value="vector.[$r.$vx * 1m, $r.$vy * 1m, $r.$vz * 1m]"/>
      </set_object_velocity>
     </do_if>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|AlignDispatched|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,@$ship.sector,@$ship.parent,@$ship.sector.macro.id,$target]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|align_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="Readback" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'Readback'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardShip"/>
    <do_if value="$valid">
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Readback|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$ship.sector,$ship.parent,$ship.sector.macro.id,$ship.idcode]"/>
    </do_if>
    <do_else>
     <set_value name="$diag_ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$index}"/>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|readback_guard_sec=%s_par=%s_op=%s'.[@$r.$request_id,@$diag_ship.sector.macro.id,@$diag_ship.parent.class,@$diag_ship.isoperational]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="InspectInitial" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'InspectInitial'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardShip"/>
    <do_if value="$valid">
     <set_value name="$candidates" exact="[macro.cluster_14_sector001_macro, macro.cluster_01_sector001_macro, macro.cluster_06_sector001_macro, macro.cluster_02_sector001_macro]"/>
     <set_value name="$target_macro" exact="''"/>
     <do_all exact="$candidates.count" counter="$i">
      <do_if value="$target_macro == ''">
       <find_sector name="$found" macro="$candidates.{$i}" multiple="true" required="false"/>
       <do_if value="@$found.count == 1 and @$found.{1}.isclass.sector and $found.{1} != $ship.sector">
        <set_value name="$target_macro" exact="$found.{1}.macro.id"/>
       </do_if>
      </do_if>
     </do_all>
     <do_if value="$target_macro != ''">
      <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Initial|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$ship.sector,$ship.parent,$ship.sector.macro.id,$target_macro,$ship.idcode,$ship.macro.id,$ship.owner.id]"/>
     </do_if>
     <do_else>
      <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|no_target_sector'.[@$r.$request_id]"/>
     </do_else>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|initial_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="StepGuard" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'StepGuard'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardShip"/>
    <do_if value="$valid and $r.$expected_sector? and @$ship.sector.macro.id == $r.$expected_sector">
     <do_if value="$r.$vx? and $r.$vy? and $r.$vz?">
      <set_object_velocity object="$ship" constantvel="true">
       <linear value="vector.[$r.$vx * 1m, $r.$vy * 1m, $r.$vz * 1m]"/>
      </set_object_velocity>
     </do_if>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|StepReady|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$index,$ship,$ship.sector,$ship.parent,$ship.sector.macro.id]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Refused|step_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="Release" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityNpcReacquisition'" control="'Release'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <do_if value="@State.$owned_ship.exists and State.$owned_ship.isoperational">
     <set_object_velocity object="State.$owned_ship" constantvel="false"/>
     <do_if value="@State.$owned_wait.exists">
      <cancel_order order="State.$owned_wait"/>
     </do_if>
    </do_if>
    <set_value name="State.$owned_wait" exact="null"/>
    <set_value name="State.$owned_ship" exact="null"/>
    <raise_lua_event name="'X4AuthorityNpcReacquisition.Result'" param="'%s|Released'.[@$r.$request_id]"/>
   </actions>
  </cue>

  <library purpose="include_actions" name="GuardShip">
   <actions>
    <set_value name="$valid" exact="false"/>
    <set_value name="$ship" exact="null"/>
    <do_if value="$r.$request_id? and $r.$epoch? and $r.$index?">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$faulted?">
      <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and $r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $r.$index ge 1 and $r.$index le md.X4AuthorityShipRegistry.State.$last and $r.$index == ($r.$index)i">
       <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$index}"/>
       <do_if value="@$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $r.$index and @$ship.sector.isclass.sector and @$ship.parent.isclass.zone">
        <do_if value="$ship != player.controlled and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored">
         <set_value name="$valid" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </actions>
  </library>
 </cues>
</mdscript>
