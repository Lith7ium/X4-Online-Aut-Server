<?xml version="1.0" encoding="utf-8"?>
<mdscript name="X4AuthorityCompanyBerthAdoption" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!-- Developer overlay only. The caller authenticates the participant and checks its
       current seat reservation before forwarding a request. MD rechecks native identity. -->
  <cues>
    <cue name="State" namespace="this">
      <actions>
        <set_value name="$Pending" exact="table[]"/>
        <set_value name="$PendingBays" exact="table[]"/>
      </actions>
      <cues>
        <cue name="Adopt" instantiate="true" namespace="this">
          <conditions>
            <event_ui_triggered screen="'X4AuthorityCompanyBerthAdoption'" control="'Adopt'"/>
          </conditions>
          <actions>
            <set_value name="$Request" exact="event.param3"/>
            <set_value name="$Nonce" exact="@$Request.$nonce"/>
            <set_value name="$Index" exact="@$Request.$index"/>
            <set_value name="$Status" exact="'invalid_request'"/>
            <set_value name="$Route" exact="'none'"/>
            <set_value name="$Actual" exact="null"/>
            <do_if value="$Nonce and $Nonce != ''
                          and $Index and $Index ge 1 and $Index == ($Index)i
                          and $Index le @md.X4AuthorityShipRegistry.State.$last
                          and @$Request.$epoch and $Request.$epoch == @md.X4AuthorityShipRegistry.State.$epoch
                          and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted">
              <set_value name="$Ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$Index}"/>
              <set_value name="$Status" exact="'ship_mismatch'"/>
              <do_if value="@$Ship.isclass.ship and $Ship.isoperational
                            and $Ship.owner == faction.player and $Ship.trueowner == faction.player
                            and $Ship.idcode == @$Request.$ship_code and $Ship.sector.macro.id == @$Request.$sector
                            and @md.X4AuthorityShipRegistry.State.$byship.{$Ship} == $Index">
                <set_value name="$Status" exact="'avatar_not_parked'"/>
                <do_if value="@$Ship != player.container and not player.controlled and not player.occupiedship
                              and @player.station.isclass.station and @player.room.exists and @player.entity.hascontext.{player.station}">
                  <set_value name="$Avatar" exact="player.entity"/>
                  <set_value name="$AvatarStation" exact="player.station"/>
                  <set_value name="$AvatarRoom" exact="player.room"/>
                  <set_value name="$AvatarContainer" exact="player.container"/>
                  <do_if value="@State.$Pending.{$Ship}">
                    <set_value name="$Status" exact="'pending'"/>
                  </do_if>
                  <do_else>
                    <include_actions ref="Select"/>
                    <do_if value="$Status == 'selected'">
                      <set_value name="State.$Pending.{$Ship}" exact="$Nonce"/>
                      <set_value name="State.$PendingBays.{$Actual}" exact="$Nonce"/>
                      <set_value name="$Status" exact="'dispatched'"/>
                      <spawn_docked ship="$Ship" dock="$Actual"/>
                    </do_if>
                  </do_else>
                </do_if>
              </do_if>
            </do_if>
            <do_if value="$Status != 'dispatched'">
              <include_actions ref="Report"/>
            </do_if>
          </actions>
          <cues>
            <cue name="Readback" checkinterval="1s">
              <conditions>
                <check_value value="@$Status == 'dispatched'"/>
              </conditions>
              <delay exact="2s"/>
              <actions>
                <set_value name="$Status" exact="'readback_failed'"/>
                <do_if value="@$Ship.isoperational
                              and $Request.$epoch == @md.X4AuthorityShipRegistry.State.$epoch and not @md.X4AuthorityShipRegistry.State.$faulted
                              and $Ship == @md.X4AuthorityShipRegistry.State.$ships.{$Index}
                              and @md.X4AuthorityShipRegistry.State.$byship.{$Ship} == $Index and $Ship.idcode == $Request.$ship_code
                              and $Ship.owner == faction.player and $Ship.trueowner == faction.player
                              and @$Station.isoperational and $Station.idcode == $Request.$station_code
                              and $Station.sector.macro.id == $Request.$sector and $Ship.sector == $Station.sector
                              and @$Ship.dock == $Actual and not $Ship.isinternallystored
                              and @$Actual.container == $Station and $Actual.external
                              and $Actual.istradingallowed and $Actual.dockstate == dockstate.default
                              and $Actual.docked.count == 1 and $Actual.docked.{1} == $Ship
                              and not $Ship.pilot and not $Ship.assignedpilot and not $Ship.orders.count
                              and player.entity == $Avatar and player.station == $AvatarStation
                              and player.room == $AvatarRoom and player.container == $AvatarContainer and not player.controlled and not player.occupiedship">
                  <set_value name="$Status" exact="'adopted'"/>
                </do_if>
                <remove_value name="State.$Pending.{$Ship}"/>
                <remove_value name="State.$PendingBays.{$Actual}"/>
                <do_if value="$Status != 'adopted'">
                  <set_value name="$Actual" exact="null"/>
                  <set_value name="$Route" exact="'none'"/>
                </do_if>
                <include_actions ref="Report"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>

    <!-- Read-only. Resolve the reported berth independently of availability, then
         restrict selection to compatible, operational berths on that same station. -->
    <library name="Select" purpose="include_actions">
      <actions>
        <set_value name="$Status" exact="'station_unavailable'"/>
        <find_station name="$Stations" space="$Ship.sector" functional="true" checkoperational="true" multiple="true" required="false"/>
        <set_value name="$Station" exact="null"/>
        <set_value name="$StationMatches" exact="0"/>
        <do_for_each name="$CandidateStation" in="$Stations">
          <do_if value="$CandidateStation.idcode == @$Request.$station_code">
            <set_value name="$Station" exact="$CandidateStation"/>
            <set_value name="$StationMatches" operation="add"/>
          </do_if>
        </do_for_each>
        <do_if value="$StationMatches == 1 and $Station.dockingallowed.{$Ship}">
          <set_value name="$Status" exact="'berth_mismatch'"/>
          <set_value name="$Requested" exact="null"/>
          <set_value name="$BerthMatches" exact="0"/>
          <find_dockingbay name="$StationBays" object="$Station" multiple="true" required="false"/>
          <do_for_each name="$Bay" in="$StationBays">
            <do_if value="$Bay.container == $Station and $Bay.external and not $Bay.isstorage
                          and '%s'.[$Bay.seed] == @$Request.$bay_seed
                          and $Bay.macro.id == @$Request.$bay_macro and @$Bay.dockarea.macro.id == @$Request.$dockarea_macro">
              <set_value name="$Requested" exact="$Bay"/>
              <set_value name="$BerthMatches" operation="add"/>
            </do_if>
          </do_for_each>
          <do_if value="$BerthMatches == 1">
            <include_actions ref="SelectEligible"/>
          </do_if>
        </do_if>
      </actions>
    </library>

    <library name="SelectEligible" purpose="include_actions">
      <actions>
        <find_dockingbay name="$CompatibleBays" object="$Station" checkoperational="true" multiple="true" required="false">
          <match_dock size="$Ship.docksize" trading="true" allowplayeronly="false" showroom="false" storage="false"/>
          <match_relation_to object="$Ship" comparison="not" relation="enemy"/>
        </find_dockingbay>
        <set_value name="$Status" exact="'requested_berth_unavailable'"/>
        <do_if value="$CompatibleBays.indexof.{$Requested} and $Requested.isdockingallowed
                      and $Requested.istradingallowed and $Requested.dockstate == dockstate.default">
          <include_actions ref="ChooseBerth"/>
        </do_if>
      </actions>
    </library>

    <library name="ChooseBerth" purpose="include_actions">
      <actions>
        <set_value name="$Status" exact="'ship_busy'"/>
        <do_if value="not $Ship.isinternallystored and not $Ship.pilot and not $Ship.assignedpilot
                      and not $Ship.orders.count and not $Ship.commander and not $Ship.subordinates.count
                      and (not $Ship.defaultorder or $Ship.defaultorder.id == 'Wait')">
          <do_if value="@$Ship.dock">
            <set_value name="$Dock" exact="$Ship.dock"/>
            <do_if value="$CompatibleBays.indexof.{$Dock} and $Dock.container == $Station and $Dock.external
                          and $Dock.istradingallowed and $Dock.dockstate == dockstate.default
                          and $Dock.docked.count == 1 and $Dock.docked.{1} == $Ship">
              <set_value name="$Actual" exact="$Dock"/>
              <set_value name="$Status" exact="'already_docked'"/>
            </do_if>
          </do_if>
          <do_elseif value="not @$Ship.assigneddock">
            <set_value name="$RequestedOccupied" exact="@$Requested.assignedship.exists
                             or $Requested.docked.count gt 0 or @State.$PendingBays.{$Requested}"/>
            <set_value name="$Status" exact="if $RequestedOccupied then 'no_free_berth' else 'requested_berth_unavailable'"/>
            <find_dockingbay name="$FreeBays" object="$Station" checkoperational="true" multiple="true" required="false">
              <match_dock size="$Ship.docksize" free="true" trading="true" allowplayeronly="false" showroom="false" storage="false"/>
              <match_relation_to object="$Ship" comparison="not" relation="enemy"/>
            </find_dockingbay>
            <!-- Compare native seeds without converting the descriptor to a number.
                 A tie cannot produce an unambiguous portable berth. -->
            <set_value name="$BestSeedTied" exact="false"/>
            <do_for_each name="$Candidate" in="$FreeBays">
              <do_if value="$Candidate.container == $Station and $Candidate.external and not $Candidate.isstorage
                            and $Candidate.isdockingallowed and $Candidate.istradingallowed
                            and $Candidate.dockstate == dockstate.default
                            and not @$Candidate.assignedship.exists and $Candidate.docked.count == 0
                            and not @State.$PendingBays.{$Candidate}">
                <do_if value="$Candidate == $Requested
                              or ($RequestedOccupied
                                  and (not $Actual or ($Actual != $Requested and $Candidate.seed lt $Actual.seed)))">
                  <set_value name="$Actual" exact="$Candidate"/>
                  <set_value name="$BestSeedTied" exact="false"/>
                </do_if>
                <do_elseif value="$Actual and $Actual != $Requested and $Actual != $Candidate
                                  and $Actual.seed == $Candidate.seed">
                  <set_value name="$BestSeedTied" exact="true"/>
                </do_elseif>
              </do_if>
            </do_for_each>
            <do_if value="$BestSeedTied">
              <set_value name="$Actual" exact="null"/>
              <set_value name="$Status" exact="'ambiguous_fallback'"/>
            </do_if>
            <do_elseif value="$Actual">
              <set_value name="$Status" exact="'selected'"/>
            </do_elseif>
          </do_elseif>
        </do_if>
        <do_if value="$Actual">
          <set_value name="$Route" exact="if $Actual == $Requested then 'exact' else 'fallback'"/>
        </do_if>
      </actions>
    </library>

    <library name="Report" purpose="include_actions">
      <actions>
        <raise_lua_event name="'X4AuthorityCompanyBerthAdoption.Result'"
                         param="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$Nonce,$Status,$Route,$Index,@$Request.$sector,@$Request.$station_code,
                                 @$Request.$bay_seed,@$Request.$bay_macro,@$Request.$dockarea_macro,
                                 @$Actual.seed,@$Actual.macro.id,@$Actual.dockarea.macro.id]"/>
      </actions>
    </library>
  </cues>
</mdscript>
