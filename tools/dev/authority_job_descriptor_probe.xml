<?xml version="1.0" encoding="utf-8"?>
<!-- Default-off read-only diagnostic. Runtime identifiers are process-local. -->
<mdscript name="X4AuthorityJobDescriptorProbe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues><cue name="Read" instantiate="true">
  <conditions><event_ui_triggered screen="'X4AuthorityJobDescriptorProbe'" control="'Read'"/></conditions>
  <actions>
   <set_value name="$v" exact="event.param3"/><set_value name="$index" exact="$v.$index"/>
   <do_if value="md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and not md.X4AuthorityShipRegistry.State.$faulted and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $index ge 1 and $index le md.X4AuthorityShipRegistry.State.$last and $index == ($index)i">
    <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
    <do_if value="@$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and @$ship.sector.isclass.sector and $ship.macro and $ship.owner and $ship.sector.macro">
     <!-- Scoped to numbered descriptors from the opt-in provider, never its lookup.
          These point observations go only to the local debug log. -->
     <do_if value="@$v.$registered_npc_velocity_sequence ge 1 and $v.$registered_npc_velocity_sequence le 48 and $v.$registered_npc_velocity_sequence == ($v.$registered_npc_velocity_sequence)i and @$v.$registered_npc_velocity_actor == $ship and $ship != player.controlled and $ship.owner != faction.player and @$ship.pilot and $ship.pilot != player.entity">
      <set_value name="$velocity" exact="$ship.velocity"/>
      <set_value name="$rotation" exact="$ship.relativerotation.{$ship.sector}"/>
      <set_value name="$position" exact="$ship.relativeposition.{$ship.sector}"/>
      <debug_text text="'[X4LAN] AUTH_REGISTERED_NPC_VELOCITY|seq=%s|index=%s|age_s=%s|local_mps=%s,%s,%s|right=%s,%s,%s|up=%s,%s,%s|forward=%s,%s,%s|sector_m=%s,%s,%s'.[$v.$registered_npc_velocity_sequence,$index,player.age / 1s,$velocity.x / 1m,$velocity.y / 1m,$velocity.z / 1m,$rotation.right.x / 1m,$rotation.right.y / 1m,$rotation.right.z / 1m,$rotation.up.x / 1m,$rotation.up.y / 1m,$rotation.up.z / 1m,$rotation.forward.x / 1m,$rotation.forward.y / 1m,$rotation.forward.z / 1m,$position.x / 1m,$position.y / 1m,$position.z / 1m]"/>
     </do_if>
     <raise_lua_event name="'X4AuthorityJobDescriptorProbe.Result'" param="'%s|%s|%s|ok|%s|%s|%s|%s|%s'.[$v.$request_id,$v.$epoch,$index,$ship,$ship.macro.id,$ship.owner.id,$ship.sector,$ship.sector.macro.id]"/>
    </do_if>
    <!-- A superhighway corridor can temporarily have no sector. Only the
         selected Company sender requests this distinct, pose-free response. -->
    <do_elseif value="@$v.$allow_superhighway_gap == true and @$ship.isoperational and $ship.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index and $ship == player.controlled and $ship.pilot == player.entity and not @$ship.sector.isclass.sector and @$ship.macro and $ship.owner == faction.player and $ship.trueowner == faction.player and @$ship.zone.issuperhighway">
     <raise_lua_event name="'X4AuthorityJobDescriptorProbe.Result'" param="'%s|%s|%s|transit|%s'.[$v.$request_id,$v.$epoch,$index,$ship]"/>
    </do_elseif>
    <do_else>
     <raise_lua_event name="'X4AuthorityJobDescriptorProbe.Result'" param="'%s|%s|%s|unavailable'.[$v.$request_id,$v.$epoch,$index]"/>
     <!-- Diagnostic rechecks are point observations, not the original failure. -->
     <do_if value="not $ship">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK ship_missing'"/>
     </do_if>
     <do_elseif value="not @$ship.isoperational">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK ship_not_operational'"/>
     </do_elseif>
     <do_elseif value="not @$ship.isclass.ship">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK not_ship'"/>
     </do_elseif>
     <do_elseif value="@md.X4AuthorityShipRegistry.State.$byship.{$ship} != $index">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK reverse_mismatch'"/>
     </do_elseif>
     <do_elseif value="not @$ship.sector.isclass.sector">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK sector_invalid'"/>
     </do_elseif>
     <do_elseif value="not @$ship.macro">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK ship_macro_missing'"/>
     </do_elseif>
     <do_elseif value="not @$ship.owner">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK owner_missing'"/>
     </do_elseif>
     <do_elseif value="not @$ship.sector.macro">
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK sector_macro_missing'"/>
     </do_elseif>
     <do_else>
      <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK all_pass_on_recheck'"/>
     </do_else>
    </do_else>
   </do_if>
   <do_else>
    <raise_lua_event name="'X4AuthorityJobDescriptorProbe.Result'" param="'%s|%s|%s|unavailable'.[$v.$request_id,$v.$epoch,$index]"/>
    <!-- Short-circuit missing state before reading values from the registry. -->
    <do_if value="not md.X4AuthorityShipRegistry.State.$faulted?">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK registry_faulted_field_missing'"/>
    </do_if>
    <do_elseif value="not md.X4AuthorityShipRegistry.State.$ships?">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK registry_ships_missing'"/>
    </do_elseif>
    <do_elseif value="not md.X4AuthorityShipRegistry.State.$byship?">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK registry_byship_missing'"/>
    </do_elseif>
    <do_elseif value="not md.X4AuthorityShipRegistry.State.$epoch?">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK registry_epoch_missing'"/>
    </do_elseif>
    <do_elseif value="not md.X4AuthorityShipRegistry.State.$last?">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK registry_last_missing'"/>
    </do_elseif>
    <do_elseif value="@md.X4AuthorityShipRegistry.State.$faulted">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK registry_faulted'"/>
    </do_elseif>
    <do_elseif value="@$v.$epoch != @md.X4AuthorityShipRegistry.State.$epoch">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK epoch_mismatch'"/>
    </do_elseif>
    <do_elseif value="$index lt 1">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK index_below_range'"/>
    </do_elseif>
    <do_elseif value="$index gt @md.X4AuthorityShipRegistry.State.$last">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK index_above_range'"/>
    </do_elseif>
    <do_elseif value="$index != ($index)i">
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK index_noninteger'"/>
    </do_elseif>
    <do_else>
     <debug_text text="'[X4LAN] AUTH_DESCRIPTOR_RECHECK all_pass_on_recheck'"/>
    </do_else>
   </do_else>
  </actions>
 </cue></cues>
</mdscript>
