<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable opt-in MD probe for native Windows registered-NPC receive/playback verification.
     Never auto-runs: every cue requires an explicit correlated UI-triggered event. -->
<mdscript name="X4AuthorityWindowsNpcPlayback" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <actions>
    <set_value name="$owned_ship" exact="null"/>
    <set_value name="$owned_wait" exact="null"/>
   </actions>
  </cue>

  <!-- Phase 1: Populate X4AuthorityShipRegistry across player.galaxy, spawn & enroll one
       unrelated stationary visible ship 450 m ahead of the player in player.sector, and return
       up to 32 operational undocked non-player AI-piloted NPC candidates in player.sector. -->
  <cue name="SetupCapture" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityWindowsNpcPlayback'" control="'SetupCapture'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <set_value name="$epoch" exact="@$r.$epoch"/>
    <do_if value="$r.$request_id? and $epoch? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$epoch == $epoch and not @md.X4AuthorityShipRegistry.State.$faulted and @player.controlled.isclass.ship and @player.sector.isclass.sector">
     <set_value name="md.X4AuthorityShipRegistry.State.$ships" exact="table[]"/>
     <set_value name="md.X4AuthorityShipRegistry.State.$byship" exact="table[]"/>
     <set_value name="md.X4AuthorityShipRegistry.State.$last" exact="0"/>

     <!-- Spawn one unrelated visible uncrewed ship directly ahead of player.controlled. -->
     <create_ship name="$unrelated" macro="macro.ship_arg_s_fighter_03_a_macro" sector="player.sector" seed="7391">
      <owner exact="faction.player" overridenpc="true"/>
      <loadout><level exact="1.0"/><variation exact="0"/></loadout>
      <position object="player.controlled" x="0m" y="0m" z="650m"/>
      <rotation yaw="0deg" pitch="0deg" roll="0deg"/>
     </create_ship>

     <find_ship name="$all" space="player.galaxy" multiple="true"/>
     <set_value name="$count" exact="0"/>
     <set_value name="$near_rows" exact="''"/>
     <set_value name="$near_n" exact="0"/>
     <set_value name="$far_rows" exact="''"/>
     <set_value name="$far_n" exact="0"/>
     <set_value name="$radar" exact="if @player.controlled.currentradarrange gt 0m then player.controlled.currentradarrange else 40000m"/>
     <do_all exact="$all.count" counter="$i">
      <set_value name="$s" exact="$all.{$i}"/>
      <do_if value="@$s.isoperational and $s.isclass.ship">
       <set_value name="$count" exact="$count + 1"/>
       <set_value name="md.X4AuthorityShipRegistry.State.$ships.{$count}" exact="$s"/>
       <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$s}" exact="$count"/>
       <do_if value="$s.owner != faction.player and @$s.pilot.exists and $s != player.controlled and $s != player.ship and $s != player.occupiedship and $s != player.container and $s != $unrelated and not $s.dock.exists and not $s.isinternallystored and @$s.sector == player.sector and @$s.parent.isclass.zone">
        <set_value name="$d" exact="$s.distanceto.{player.controlled}"/>
        <do_if value="$d le $radar and $near_n lt 48">
         <set_value name="$near_n" exact="$near_n + 1"/>
         <do_if value="$near_rows != ''">
          <set_value name="$near_rows" exact="$near_rows + ';'"/>
         </do_if>
         <set_value name="$near_rows" exact="$near_rows + '%s,%s,%s,%s,%s,%s'.[$count,$s,$s.idcode,$s.owner.id,$s.macro.id,$d]"/>
        </do_if>
        <do_elseif value="$far_n lt 24">
         <set_value name="$far_n" exact="$far_n + 1"/>
         <do_if value="$far_rows != ''">
          <set_value name="$far_rows" exact="$far_rows + ';'"/>
         </do_if>
         <set_value name="$far_rows" exact="$far_rows + '%s,%s,%s,%s,%s,%s'.[$count,$s,$s.idcode,$s.owner.id,$s.macro.id,$d]"/>
        </do_elseif>
       </do_if>
      </do_if>
     </do_all>
     <set_value name="md.X4AuthorityShipRegistry.State.$last" exact="$count"/>
     <set_value name="$own_idx" exact="@md.X4AuthorityShipRegistry.State.$byship.{player.controlled}"/>
     <set_value name="$unrel_idx" exact="@md.X4AuthorityShipRegistry.State.$byship.{$unrelated}"/>
     <set_value name="$cands" exact="$near_rows"/>
     <do_if value="$far_rows != ''">
      <do_if value="$cands != ''">
       <set_value name="$cands" exact="$cands + ';' + $far_rows"/>
      </do_if>
      <do_else>
       <set_value name="$cands" exact="$far_rows"/>
      </do_else>
     </do_if>
     <do_if value="$own_idx and $unrel_idx and @$unrelated.isoperational">
      <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|CaptureSetup|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$count,$own_idx,player.controlled,player.controlled.idcode,player.sector.macro.id,$unrel_idx,$unrelated,$unrelated.idcode,$unrelated.distanceto.{player.controlled},$radar,$cands]"/>
     </do_if>
     <do_else>
      <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Refused|setup_enroll_missing'.[$r.$request_id]"/>
     </do_else>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Refused|setup_args'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <!-- Phase 2: Cold-reload resolution of own ship, registered moving NPC, and unrelated visible
       ship directly against the saved X4AuthorityShipRegistry (zero re-population). -->
  <cue name="ResolveSaved" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityWindowsNpcPlayback'" control="'ResolveSaved'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardAllThree"/>
    <do_if value="$all_valid">
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Resolved|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$r.$request_id,md.X4AuthorityShipRegistry.State.$last,$r.$own_index,$own,$own.idcode,$own.sector.macro.id,$r.$npc_index,$npc,$npc.idcode,$npc.owner.id,$npc.sector.macro.id,$npc.distanceto.{$own},$r.$unrelated_index,$unrelated,$unrelated.idcode,$unrelated.sector.macro.id,$unrelated.distanceto.{$own}]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Refused|resolve_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <!-- Phase 2: Hold Wait order + constantvel=0 ONLY on the target registered moving NPC so
       local AI does not fight ordinary playback writes; never touches unrelated or own ship. -->
  <cue name="PreparePlayback" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityWindowsNpcPlayback'" control="'PreparePlayback'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardNpc"/>
    <do_if value="$npc_valid and $r.$expected_sector? and @$npc.sector.macro.id == $r.$expected_sector">
     <do_if value="@State.$owned_ship.exists and State.$owned_ship != $npc">
      <set_object_velocity object="State.$owned_ship" constantvel="false"/>
      <do_if value="@State.$owned_wait.exists">
       <cancel_order order="State.$owned_wait"/>
      </do_if>
      <set_value name="State.$owned_wait" exact="null"/>
     </do_if>
     <do_if value="@State.$owned_ship != $npc or not @State.$owned_wait.exists">
      <create_order object="$npc" id="'Wait'" immediate="true" name="State.$owned_wait">
       <param name="timeout" value="180s"/>
       <param name="skipalignment" value="true"/>
       <param name="fidget" value="false"/>
       <param name="noattackresponse" value="true"/>
      </create_order>
      <set_value name="State.$owned_ship" exact="$npc"/>
     </do_if>
     <set_object_velocity object="$npc" constantvel="true">
      <linear value="vector.[0m, 0m, 0m]"/>
     </set_object_velocity>
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|PlaybackReady|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$npc_index,$npc,$npc.sector,$npc.parent,$npc.sector.macro.id,$npc.idcode]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Refused|prepare_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <!-- Phase 2: Independent correlated post-playback readback of all three registered ships. -->
  <cue name="FinalReadback" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityWindowsNpcPlayback'" control="'FinalReadback'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <include_actions ref="GuardAllThree"/>
    <do_if value="$all_valid">
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|FinalReadback|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$r.$own_index,$own,$own.idcode,$own.sector.macro.id,$r.$npc_index,$npc,$npc.idcode,$npc.owner.id,$npc.sector.macro.id,$npc.distanceto.{$own},$r.$unrelated_index,$unrelated,$unrelated.idcode,$unrelated.distanceto.{$own}]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Refused|final_readback_guard'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <!-- Release owned Wait order and constantvel cleanly before exit. -->
  <cue name="Release" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityWindowsNpcPlayback'" control="'Release'"/>
   </conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <do_if value="@State.$owned_ship.exists and State.$owned_ship.isoperational">
     <set_object_velocity object="State.$owned_ship" constantvel="false"/>
     <do_if value="@State.$owned_wait.exists">
      <cancel_order order="State.$owned_wait"/>
     </do_if>
    </do_if>
    <set_value name="State.$owned_wait" exact="null"/>
    <set_value name="State.$owned_ship" exact="null"/>
    <raise_lua_event name="'X4AuthorityWindowsNpcPlayback.Result'" param="'%s|Released'.[@$r.$request_id]"/>
   </actions>
  </cue>

  <library purpose="include_actions" name="GuardNpc">
   <actions>
    <set_value name="$npc_valid" exact="false"/>
    <set_value name="$npc" exact="null"/>
    <do_if value="$r.$request_id? and $r.$epoch? and $r.$npc_index?">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$faulted?">
      <do_if value="not md.X4AuthorityShipRegistry.State.$faulted and $r.$epoch == md.X4AuthorityShipRegistry.State.$epoch and $r.$npc_index ge 1 and $r.$npc_index le md.X4AuthorityShipRegistry.State.$last and $r.$npc_index == ($r.$npc_index)i">
       <set_value name="$npc" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$npc_index}"/>
       <do_if value="@$npc.isoperational and $npc.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$npc} == $r.$npc_index and @$npc.sector.isclass.sector and @$npc.parent.isclass.zone">
        <do_if value="$npc.owner != faction.player and @$npc.pilot.exists and $npc != player.controlled and $npc != player.ship and $npc != player.occupiedship and $npc != player.container and not $npc.dock.exists and not $npc.isinternallystored">
         <set_value name="$npc_valid" exact="true"/>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </actions>
  </library>

  <library purpose="include_actions" name="GuardAllThree">
   <actions>
    <set_value name="$all_valid" exact="false"/>
    <set_value name="$own" exact="null"/>
    <set_value name="$unrelated" exact="null"/>
    <include_actions ref="GuardNpc"/>
    <do_if value="$npc_valid and $r.$own_index? and $r.$unrelated_index?">
     <do_if value="$r.$own_index ge 1 and $r.$own_index le md.X4AuthorityShipRegistry.State.$last and $r.$own_index == ($r.$own_index)i and $r.$unrelated_index ge 1 and $r.$unrelated_index le md.X4AuthorityShipRegistry.State.$last and $r.$unrelated_index == ($r.$unrelated_index)i">
      <set_value name="$own" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$own_index}"/>
      <set_value name="$unrelated" exact="@md.X4AuthorityShipRegistry.State.$ships.{$r.$unrelated_index}"/>
      <do_if value="@$own == player.controlled and @$own.isoperational and @md.X4AuthorityShipRegistry.State.$byship.{$own} == $r.$own_index and @$own.sector.isclass.sector">
       <do_if value="@$unrelated.isoperational and $unrelated.isclass.ship and @md.X4AuthorityShipRegistry.State.$byship.{$unrelated} == $r.$unrelated_index and $unrelated != $own and $unrelated != $npc and $unrelated.owner == faction.player and not @$unrelated.pilot.exists and not $unrelated.dock.exists and not $unrelated.isinternallystored and @$unrelated.sector == $own.sector and @$npc.sector == $own.sector">
        <set_value name="$all_valid" exact="true"/>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </actions>
  </library>
 </cues>
</mdscript>
