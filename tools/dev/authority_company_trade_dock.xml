<?xml version="1.0" encoding="utf-8"?>
<mdscript name="X4AuthorityTradeDock" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <!-- Install only in the isolated native trade fixture. This cue runs once. -->
  <cue name="Prepare" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityTradeDock'" control="'Prepare'"/>
   </conditions>
   <actions>
    <set_value name="$Args" exact="event.param3"/>
    <set_value name="$Nonce" exact="@$Args.$nonce"/>
    <set_value name="$Epoch" exact="@$Args.$epoch"/>
    <set_value name="$Avatar" exact="player.entity"/>
    <set_value name="$AvatarStation" exact="player.station"/>
    <set_value name="$AvatarRoom" exact="player.room"/>
    <set_value name="$AvatarContainer" exact="player.container"/>
    <include_actions ref="CheckAvatarAndShip"/>
    <do_if value="not $Safe">
     <set_value name="$Status" exact="'SOURCE_MISMATCH'"/>
    </do_if>
    <do_elseif value="$Ship.dock or $Ship.assigneddock or $Ship.isinternallystored or $Ship.pilot or $Ship.assignedpilot or $Ship.orders.count or $Ship.commander or $Ship.subordinates.count or ($Ship.defaultorder and $Ship.defaultorder.id != 'Wait')">
     <set_value name="$Status" exact="'SHIP_BUSY'"/>
    </do_elseif>
    <do_else>
     <find_station name="$Stations" space="$Ship.sector" functional="true" checkoperational="true" multiple="true" required="false"/>
     <set_value name="$Matches" exact="0"/>
     <do_for_each name="$Candidate" in="$Stations">
      <do_if value="$Candidate.idcode == 'BIM-169'">
       <set_value name="$Station" exact="$Candidate"/>
       <set_value name="$Matches" operation="add"/>
      </do_if>
     </do_for_each>
     <do_if value="$Matches != 1 or not @$Station.isclass.station or $Station.owner != faction.teladi or $Station.trueowner != faction.teladi or $Station.macro.id != 'station_gen_factory_base_01_macro' or not $Station.dockingallowed.{$Ship}">
      <set_value name="$Status" exact="'STATION_UNAVAILABLE'"/>
     </do_if>
     <do_else>
      <find_dockingbay name="$Bay" object="$Station" checkoperational="true" multiple="false" required="false" sortbydistanceto="$Ship">
       <match_dock size="$Ship.docksize" free="true" trading="true" allowplayeronly="false" showroom="false" storage="false"/>
       <match_relation_to object="$Ship" comparison="not" relation="enemy"/>
      </find_dockingbay>
      <do_if value="not @$Bay.exists or $Bay.container != $Station or not $Bay.isdockingallowed or not $Bay.istradingallowed">
       <set_value name="$Status" exact="'NO_FREE_TRADE_BAY'"/>
      </do_if>
      <do_elseif value="not $Ship.canhavecontrolentity.{controlpost.aipilot}">
       <set_value name="$Status" exact="'NO_CAPTAIN_SLOT'"/>
      </do_elseif>
      <do_else>
       <create_cue_actor name="$Captain" cue="this">
        <select faction="faction.argon" tags="tag.fighterpilot"/>
        <owner exact="faction.player"/>
       </create_cue_actor>
       <do_if value="@$Captain.isclass.npc and $Captain.owner == faction.player">
        <assign_control_entity object="$Ship" actor="$Captain" post="controlpost.aipilot" init="true" transfer="true" result="$Assigned"/>
        <set_value name="$Status" exact="if $Assigned then 'CAPTAIN_ASSIGNED' else 'CAPTAIN_ASSIGNMENT_FAILED'"/>
       </do_if>
       <do_else>
        <set_value name="$Status" exact="'CAPTAIN_CREATION_FAILED'"/>
       </do_else>
      </do_else>
     </do_else>
    </do_else>
    <do_if value="$Status != 'CAPTAIN_ASSIGNED'">
     <include_actions ref="ReportFailure"/>
    </do_if>
    <do_else>
     <debug_text text="'[X4LAN] AUTH_TRADE_DOCK_STAGE %s|CAPTAIN_ASSIGNED|age=%s|ship=%s|captain=%s|station=%s|bay=%s'.[$Nonce,player.age,$Ship,$Captain,$Station,$Bay]" chance="100"/>
    </do_else>
   </actions>
   <cues>
    <cue name="Order">
     <conditions>
      <event_cue_completed cue="parent"/>
      <check_value value="$Status == 'CAPTAIN_ASSIGNED'"/>
     </conditions>
     <delay exact="1s"/>
     <actions>
      <include_actions ref="CheckAvatarAndShip"/>
      <do_if value="not $Safe or $Ship.assignedaipilot != $Captain or $Ship.pilot != $Captain or $Ship.orders.count or ($Ship.defaultorder and $Ship.defaultorder.id != 'Wait') or $Ship.dock or $Ship.assigneddock or $Ship.isinternallystored or not @$Station.isoperational or not $Station.dockingallowed.{$Ship} or not @$Bay.isdockingallowed or not $Bay.istradingallowed or $Bay.container != $Station">
       <set_value name="$Status" exact="'DOCK_PREFLIGHT_FAILED'"/>
      </do_if>
      <do_else>
       <create_order name="$DockOrder" object="$Ship" id="'DockAt'" immediate="true">
        <param name="destination" value="$Station"/>
        <param name="trading" value="true"/>
        <param name="preferreddock" value="$Bay"/>
        <param name="preferreddockonly" value="true"/>
        <param name="store" value="false"/>
        <param name="dockfollowers" value="false"/>
        <param name="waittime" value="90s"/>
       </create_order>
       <do_if value="$DockOrder">
        <set_value name="$Deadline" exact="player.age + 300s"/>
        <set_value name="$Status" exact="'DOCKING'"/>
        <debug_text text="'[X4LAN] AUTH_TRADE_DOCK_STAGE %s|ORDER_CREATED|age=%s|deadline=%s|ship=%s|order=%s|queue_count=%s|bay=%s|station_distance=%s'.[$Nonce,player.age,$Deadline,$Ship,$DockOrder,@$Ship.orders.count,$Bay,@$Ship.distanceto.{$Station}]" chance="100"/>
       </do_if>
       <do_else>
        <set_value name="$Status" exact="'ORDER_CREATION_FAILED'"/>
       </do_else>
      </do_else>
      <do_if value="$Status != 'DOCKING'">
       <include_actions ref="ReportFailure"/>
      </do_if>
     </actions>
     <cues>
      <cue name="FirstObservation" checkinterval="1s">
       <conditions>
        <check_value value="@$Status == 'DOCKING'"/>
        <check_value value="player.age ge $Deadline or not @$Ship.isoperational or $Ship.orders.count == 0"/>
       </conditions>
       <actions>
        <include_actions ref="CheckDocked"/>
        <do_if value="$Docked and player.age lt $Deadline">
         <set_value name="$FirstObservationAge" exact="player.age"/>
         <set_value name="$Status" exact="'DOCKED_ONCE'"/>
        </do_if>
        <do_else>
         <set_value name="$Status" exact="if player.age ge $Deadline then 'DOCK_TIMEOUT' else 'DOCK_STATE_CHANGED'"/>
         <include_actions ref="ReportFailure"/>
        </do_else>
       </actions>
       <cues>
        <cue name="LaterObservation">
         <conditions>
          <event_cue_completed cue="parent"/>
          <check_value value="$Status == 'DOCKED_ONCE'"/>
         </conditions>
         <delay exact="1s"/>
         <actions>
          <include_actions ref="CheckDocked"/>
          <do_if value="$Docked and player.age gt $FirstObservationAge">
           <set_value name="$Status" exact="'READY'"/>
           <debug_text text="'[X4LAN] AUTH_TRADE_DOCK %s|READY|7354|%s|%s|%s|%s|%s|%s|%s|%s'.[$Nonce,$Ship.idcode,$Station.idcode,$Bay,$Captain,$Avatar,$AvatarStation.idcode,$FirstObservationAge,player.age]" chance="100"/>
           <raise_lua_event name="'X4AuthorityTradeDock.Result'" param="'%s|READY|%s|%s|%s|%s'.[$Nonce,$Ship,$Station,$Bay,player.age]"/>
          </do_if>
          <do_else>
           <set_value name="$Status" exact="'DOCK_STATE_CHANGED'"/>
           <include_actions ref="ReportFailure"/>
          </do_else>
         </actions>
        </cue>
       </cues>
      </cue>
     </cues>
    </cue>
   </cues>
  </cue>

  <library name="CheckAvatarAndShip" purpose="include_actions">
   <actions>
    <set_value name="$RegistryEpoch" exact="@md.X4AuthorityShipRegistry.State.$epoch"/>
    <set_value name="$FaultKnown" exact="md.X4AuthorityShipRegistry.State.$faulted?"/>
    <set_value name="$RegistryFault" exact="@md.X4AuthorityShipRegistry.State.$faulted"/>
    <set_value name="$Ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{7354}"/>
    <set_value name="$ShipCode" exact="@$Ship.idcode"/>
    <set_value name="$ShipMacro" exact="@$Ship.macro.id"/>
    <set_value name="$ShipSector" exact="@$Ship.sector.macro.id"/>
    <set_value name="$ShipIndex" exact="if $Ship then @md.X4AuthorityShipRegistry.State.$byship.{$Ship} else 0"/>
    <set_value name="$ParkingCode" exact="@$AvatarStation.idcode"/>
    <set_value name="$ParkingSector" exact="@$AvatarStation.sector.macro.id"/>
    <set_value name="$NonceOK" exact="$Nonce != null and $Nonce != ''"/>
    <set_value name="$EpochOK" exact="$Epoch != null and $Epoch != '' and $Epoch == $RegistryEpoch"/>
    <set_value name="$ShipClassOK" exact="@$Ship.isclass.ship"/>
    <set_value name="$ShipOperational" exact="@$Ship.isoperational"/>
    <set_value name="$ShipOwnerOK" exact="@$Ship.owner == faction.player"/>
    <set_value name="$AvatarSame" exact="@$Avatar.exists and player.entity == $Avatar"/>
    <set_value name="$StationSame" exact="@$AvatarStation.isclass.station and player.station == $AvatarStation"/>
    <set_value name="$StationContext" exact="$AvatarSame and $StationSame and @player.entity.hascontext.{$AvatarStation}"/>
    <set_value name="$RoomExists" exact="@$AvatarRoom.exists"/>
    <set_value name="$RoomSame" exact="player.room == $AvatarRoom"/>
    <set_value name="$ContainerSame" exact="player.container == $AvatarContainer"/>
    <set_value name="$NoOccupiedShip" exact="not player.occupiedship"/>
    <set_value name="$NoControlledObject" exact="not player.controlled"/>
    <set_value name="$OutsideTargetShip" exact="$Ship and player.container != $Ship and not @player.entity.hascontext.{$Ship}"/>
    <set_value name="$Safe" exact="$NonceOK and $EpochOK and $FaultKnown and not $RegistryFault and $ShipClassOK and $ShipOperational and $ShipOwnerOK and $ShipCode == 'WRN-302' and $ShipMacro == 'ship_arg_s_fighter_02_a_macro' and $ShipSector == 'cluster_01_sector001_macro' and $ShipIndex == 7354 and $AvatarSame and $StationSame and $StationContext and $ParkingCode == 'XPJ-169' and $ParkingSector == 'cluster_06_sector002_macro' and $RoomExists and $RoomSame and $ContainerSame and $NoOccupiedShip and $NoControlledObject and $OutsideTargetShip"/>
   </actions>
  </library>
  <library name="CheckDocked" purpose="include_actions">
   <actions>
    <include_actions ref="CheckAvatarAndShip"/>
    <set_value name="$Docked" exact="$Safe and $Ship.dock == $Bay and not $Ship.isinternallystored and $Ship.orders.count == 0 and (not $Ship.defaultorder or $Ship.defaultorder.id == 'Wait') and $Ship.pilot == $Captain and $Ship.assignedaipilot == $Captain and @$Captain.owner == faction.player and @$Station.isoperational and $Station.owner == faction.teladi and $Station.trueowner == faction.teladi and $Station != $AvatarStation and $Bay.container == $Station and $Bay.istradingallowed"/>
   </actions>
  </library>
  <library name="ReportFailure" purpose="include_actions">
   <actions>
    <do_if value="$Status == 'DOCK_PREFLIGHT_FAILED' or $Status == 'ORDER_CREATION_FAILED' or $Status == 'DOCK_STATE_CHANGED' or $Status == 'DOCK_TIMEOUT'">
     <debug_text text="'[X4LAN] AUTH_TRADE_DOCK_STATE %s|%s|age=%s|ship=%s|operational=%s|sector=%s|captain=%s|pilot=%s|assigned_pilot=%s|commander=%s|order=%s|order_state=%s|default_order=%s|queue_count=%s|fixture_order=%s|fixture_order_state=%s|destination=%s|station_distance=%s|target_bay=%s|bay_distance=%s|bay_assigned_ship=%s|bay_docked_count=%s|assigned_bay=%s|physical_bay=%s|physical_station=%s|stored=%s'.[$Nonce,$Status,player.age,$Ship,@$Ship.isoperational,@$Ship.sector.macro.id,$Captain,@$Ship.pilot,@$Ship.assignedaipilot,@$Ship.commander,@$Ship.order.id,@$Ship.order.state,@$Ship.defaultorder.id,@$Ship.orders.count,@$DockOrder,@$DockOrder.state,$Station,@$Ship.distanceto.{$Station},$Bay,@$Ship.distanceto.{$Bay},@$Bay.assignedship,@$Bay.docked.count,@$Ship.assigneddock,@$Ship.dock,@$Ship.dock.container,@$Ship.isinternallystored]" chance="100"/>
    </do_if>
    <do_if value="@$DockOrder.isorder and @$Ship.orders.indexof.{$DockOrder}">
     <cancel_order order="$DockOrder"/>
    </do_if>
    <do_if value="not $Safe">
     <debug_text text="'[X4LAN] AUTH_TRADE_DOCK_CHECK %s|%s|nonce_ok=%s|epoch=%s|registry_epoch=%s|epoch_ok=%s|fault_known=%s|fault=%s|ship=%s|ship_class_ok=%s|operational=%s|owner_ok=%s|code=%s|macro=%s|sector=%s|index=%s|avatar=%s|avatar_code=%s|avatar_same=%s|station=%s|station_same=%s|station_context=%s|parking_code=%s|parking_sector=%s|room=%s|room_exists=%s|room_same=%s|container_same=%s|no_occupied_ship=%s|no_controlled_object=%s|outside_target=%s|player_ship=%s'.[$Nonce,$Status,$NonceOK,$Epoch,$RegistryEpoch,$EpochOK,$FaultKnown,$RegistryFault,$Ship,$ShipClassOK,$ShipOperational,$ShipOwnerOK,$ShipCode,$ShipMacro,$ShipSector,$ShipIndex,$Avatar,@$Avatar.idcode,$AvatarSame,$AvatarStation,$StationSame,$StationContext,$ParkingCode,$ParkingSector,$AvatarRoom,$RoomExists,$RoomSame,$ContainerSame,$NoOccupiedShip,$NoControlledObject,$OutsideTargetShip,player.ship]" chance="100"/>
    </do_if>
    <debug_text text="'[X4LAN] AUTH_TRADE_DOCK %s|%s'.[$Nonce,$Status]" chance="100"/>
    <raise_lua_event name="'X4AuthorityTradeDock.Result'" param="'%s|%s|0|0|0|0'.[$Nonce,$Status]"/>
   </actions>
  </library>
 </cues>
</mdscript>
