<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit fixture-only Wait/linear-hold ownership; caller owns sequencing and timeouts. -->
<mdscript name="X4AuthoritySavedReplicaControl" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State" namespace="this">
   <actions>
    <set_value name="$used" exact="false" />
    <set_value name="$held" exact="false" />
    <set_value name="$released" exact="false" />
    <set_value name="$faulted" exact="false" />
    <set_value name="$last_request" exact="0" />
   </actions>
  </cue>
  <cue name="Prepare" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthoritySavedReplicaControl'" control="'Prepare'" />
   </conditions>
   <actions>
    <set_value name="$request" exact="event.param3" />
    <include_actions ref="Guard" />
    <do_if value="$valid and not State.$faulted">
     <do_if value="not State.$used and @$ship.order.exists and $request.$owner? and ($fixture_code != 'MFQ-419' or $ship.order.state == orderstate.started)">
      <set_value name="State.$used" exact="true" />
      <set_value name="State.$ship" exact="$ship" />
      <set_value name="State.$sector" exact="$ship.sector" />
      <set_value name="State.$zone" exact="$ship.parent" />
      <set_value name="State.$owner" exact="$request.$owner" />
      <set_value name="State.$prior_order" exact="$ship.order" />
      <do_if value="$fixture_code == 'MFQ-419'">
       <set_value name="State.$pilot" exact="$ship.pilot" />
      </do_if>
      <create_order object="$ship" id="'Wait'" immediate="true" name="State.$owned_wait">
       <param name="timeout" value="30s" />
       <param name="skipalignment" value="true" />
       <param name="fidget" value="false" />
       <param name="noattackresponse" value="true" />
      </create_order>
      <set_value name="$kind" exact="'Created'" />
      <include_actions ref="Reply" />
     </do_if>
     <do_else>
      <include_actions ref="Refuse" />
     </do_else>
    </do_if>
    <do_else>
     <include_actions ref="Refuse" />
    </do_else>
   </actions>
  </cue>
  <cue name="Probe" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthoritySavedReplicaControl'" control="'Probe'" />
   </conditions>
   <actions>
    <set_value name="$request" exact="event.param3" />
    <include_actions ref="Guard" />
    <do_if value="$valid and not State.$faulted">
     <include_actions ref="Identity" />
     <do_if value="$same and not State.$released and @State.$owned_wait.exists and State.$owned_wait.id == 'Wait'">
      <do_if value="$ship.order == State.$owned_wait and State.$owned_wait.state == orderstate.started">
       <set_value name="$kind" exact="'Started'" />
       <include_actions ref="Reply" />
      </do_if>
      <do_else>
       <set_value name="$kind" exact="'Waiting'" />
       <include_actions ref="Reply" />
      </do_else>
     </do_if>
     <do_else>
      <include_actions ref="Refuse" />
     </do_else>
    </do_if>
    <do_else>
     <include_actions ref="Refuse" />
    </do_else>
   </actions>
  </cue>
  <cue name="Hold" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthoritySavedReplicaControl'" control="'Hold'" />
   </conditions>
   <actions>
    <set_value name="$request" exact="event.param3" />
    <include_actions ref="Guard" />
    <do_if value="$valid and not State.$faulted">
     <include_actions ref="Identity" />
     <do_if value="$same and not State.$released and @State.$owned_wait.exists and State.$owned_wait.id == 'Wait' and $ship.order == State.$owned_wait">
      <do_if value="State.$owned_wait.state == orderstate.started">
       <set_object_velocity object="$ship" constantvel="true">
        <linear value="vector.[0m, 0m, 0m]" />
       </set_object_velocity>
       <set_value name="State.$held" exact="true" />
       <set_value name="$kind" exact="'Held'" />
       <include_actions ref="Reply" />
      </do_if>
      <do_else>
       <include_actions ref="Refuse" />
      </do_else>
     </do_if>
     <do_else>
      <include_actions ref="Refuse" />
     </do_else>
    </do_if>
    <do_else>
     <include_actions ref="Refuse" />
    </do_else>
   </actions>
  </cue>
  <cue name="Check" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthoritySavedReplicaControl'" control="'Check'" />
   </conditions>
   <actions>
    <set_value name="$request" exact="event.param3" />
    <include_actions ref="Guard" />
    <do_if value="$valid and not State.$faulted">
     <include_actions ref="Identity" />
     <do_if value="$same and not State.$released and @State.$owned_wait.exists and State.$owned_wait.id == 'Wait' and $ship.order == State.$owned_wait">
      <do_if value="State.$owned_wait.state == orderstate.started">
       <do_if value="State.$held">
        <set_value name="$kind" exact="'Held'" />
        <include_actions ref="Reply" />
       </do_if>
       <do_else>
        <include_actions ref="Refuse" />
       </do_else>
      </do_if>
      <do_else>
       <include_actions ref="Refuse" />
      </do_else>
     </do_if>
     <do_else>
      <include_actions ref="Refuse" />
     </do_else>
    </do_if>
    <do_else>
     <include_actions ref="Refuse" />
    </do_else>
   </actions>
  </cue>
  <cue name="Release" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthoritySavedReplicaControl'" control="'Release'" />
   </conditions>
   <actions>
    <set_value name="$request" exact="event.param3" />
    <include_actions ref="Guard" />
    <do_if value="$valid and not State.$faulted">
     <include_actions ref="Identity" />
     <do_if value="$same and not State.$released and @State.$owned_wait.exists and State.$owned_wait.id == 'Wait' and $ship.order == State.$owned_wait">
      <do_if value="State.$owned_wait.state == orderstate.started">
       <do_if value="State.$held">
        <set_object_velocity object="$ship" constantvel="false" />
        <cancel_order order="State.$owned_wait" />
        <set_value name="State.$released" exact="true" />
        <set_value name="$kind" exact="'Released'" />
        <include_actions ref="Reply" />
       </do_if>
       <do_else>
        <include_actions ref="Refuse" />
       </do_else>
      </do_if>
      <do_else>
       <include_actions ref="Refuse" />
      </do_else>
     </do_if>
     <do_else>
      <include_actions ref="Refuse" />
     </do_else>
    </do_if>
    <do_else>
     <include_actions ref="Refuse" />
    </do_else>
   </actions>
  </cue>
  <cue name="Sample" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthoritySavedReplicaControl'" control="'Sample'" />
   </conditions>
   <actions>
    <set_value name="$request" exact="event.param3" />
    <include_actions ref="Guard" />
    <do_if value="$valid and not State.$faulted">
     <include_actions ref="Identity" />
     <do_if value="$same and State.$released and not @State.$owned_wait.exists and @State.$prior_order.exists and $ship.order == State.$prior_order and State.$prior_order.state == orderstate.started">
      <set_value name="$kind" exact="'Restored'" />
      <include_actions ref="Reply" />
     </do_if>
     <do_elseif value="$same and State.$released">
      <set_value name="$kind" exact="'Waiting'" />
      <include_actions ref="Reply" />
     </do_elseif>
     <do_else>
      <include_actions ref="Refuse" />
     </do_else>
    </do_if>
    <do_else>
     <include_actions ref="Refuse" />
    </do_else>
   </actions>
  </cue>
  <library purpose="include_actions" name="Guard">
   <actions>
    <set_value name="$valid" exact="false" />
    <do_if value="$request.$request_id? and $request.$request_sequence? and $request.$owner? and $request.$epoch? and $request.$index? and $request.$actor? and $request.$sector? and $request.$zone?">
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and md.X4AuthorityShipRegistry.State.$faulted?">
      <set_value name="$fixture_code" exact="null" />
      <do_if value="(not $request.$fixture? or $request.$fixture == 'recovery_enh_870') and $request.$epoch == '4ba7be438ebb04ec5bb85fdb95b5a488' and $request.$index == 1318">
       <set_value name="$fixture_code" exact="'ENH-870'" />
      </do_if>
      <do_elseif value="@$request.$fixture == 'recovery_mfq_419' and $request.$epoch == '26a1a365c66788aa06f0aeb9e18ff62e' and $request.$index == 943">
       <set_value name="$fixture_code" exact="'MFQ-419'" />
      </do_elseif>
      <do_if value="$fixture_code and not md.X4AuthorityShipRegistry.State.$faulted and $request.$epoch == md.X4AuthorityShipRegistry.State.$epoch and md.X4AuthorityShipRegistry.State.$last ge $request.$index">
       <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$request.$index}" />
       <do_if value="@$ship.isoperational and $ship.isclass.ship and @$ship == @$request.$actor and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $request.$index">
        <do_if value="@$ship.idcode == $fixture_code and @$ship.macro.id == 'ship_arg_m_trans_container_02_b_macro' and @$ship.owner.id == 'antigone'">
         <do_if value="@$ship.sector == @$request.$sector and @$ship.parent == @$request.$zone and @$ship.parent.isclass.zone and @$ship.sector.macro.id == 'cluster_06_sector001_macro'">
          <do_if value="$ship != player.controlled and $ship != player.ship and $ship != player.occupiedship and $ship != player.container and not $ship.dock.exists and not $ship.isinternallystored and ($fixture_code != 'MFQ-419' or (@$ship.pilot.exists and $ship.pilot != player.entity and (not State.$used or $ship.pilot == @State.$pilot)))">
           <do_if value="$request.$request_sequence ge 1 and $request.$request_sequence == ($request.$request_sequence)i and ((not State.$used and $request.$request_sequence == 1) or (State.$used and $request.$owner == State.$owner and $request.$request_sequence == State.$last_request + 1))">
            <set_value name="State.$last_request" exact="$request.$request_sequence" />
            <set_value name="$valid" exact="true" />
           </do_if>
          </do_if>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
   </actions>
  </library>
  <library purpose="include_actions" name="Identity">
   <actions>
    <set_value name="$same" exact="State.$used and $request.$owner == State.$owner and $ship == State.$ship and $ship.sector == State.$sector and $ship.parent == State.$zone" />
   </actions>
  </library>
  <library purpose="include_actions" name="Refuse">
   <actions>
    <set_value name="State.$faulted" exact="true" />
    <raise_lua_event name="'X4AuthoritySavedReplicaControl.Result'" param="'%s|Refused'.[@$request.$request_id]" />
   </actions>
  </library>
  <library purpose="include_actions" name="Reply">
   <actions>
    <raise_lua_event name="'X4AuthoritySavedReplicaControl.Result'" param="'%s|%s|%s|%s|%s'.[$request.$request_id,$kind,$ship,$ship.sector,$ship.parent]" />
   </actions>
  </library>
 </cues>
</mdscript>
