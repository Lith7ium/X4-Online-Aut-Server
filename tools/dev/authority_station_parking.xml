<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone disposable-profile test. No automatic teleport on start or reload. -->
<mdscript name="X4AuthorityStationParking" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State">
   <actions>
    <set_value name="$Issued" exact="false"/>
   </actions>
  </cue>
  <cue name="Read" instantiate="true">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityStationParking'" control="'Read'"/>
   </conditions>
   <actions>
    <set_value name="$Operation" exact="'read'"/>
    <include_actions ref="Inspect"/>
    <do_if value="$Status == 'READY' and $AtTarget">
     <set_value name="$Status" exact="if @State.$Issued then 'PARKED' else 'AT_TARGET'"/>
    </do_if>
    <do_elseif value="$Status == 'READY' and @State.$Issued">
     <set_value name="$Status" exact="'ARRIVAL_UNCONFIRMED'"/>
    </do_elseif>
    <include_actions ref="Reply"/>
   </actions>
  </cue>
  <cue name="Park" instantiate="true">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityStationParking'" control="'Park'"/>
   </conditions>
   <actions>
    <set_value name="$Operation" exact="'park'"/>
    <include_actions ref="Inspect"/>
    <do_if value="typeof $Nonce != datatype.string or not $Nonce">
     <set_value name="$Status" exact="'INVALID_REQUEST'"/>
    </do_if>
    <do_elseif value="@State.$Issued">
     <set_value name="$Status" exact="'PARK_ALREADY_ISSUED'"/>
    </do_elseif>
    <do_elseif value="$Status == 'READY'">
     <do_if value="@$Request.$target != '%s'.[$Target]">
      <set_value name="$Status" exact="'TARGET_CHANGED'"/>
     </do_if>
     <do_elseif value="$AtTarget">
      <set_value name="$Status" exact="'NO_ACTION'"/>
     </do_elseif>
     <do_elseif value="player.isinconversation">
      <set_value name="$Status" exact="'PLAYER_BUSY'"/>
     </do_elseif>
     <do_else>
      <set_value name="State.$Target" exact="$Target"/>
      <set_value name="State.$Code" exact="$Target.idcode"/>
      <set_value name="State.$SectorMacro" exact="$Target.sector.macro.id"/>
      <set_value name="State.$StationMacro" exact="$Target.macro.id"/>
      <set_value name="State.$OwnerID" exact="$Target.trueowner.id"/>
      <set_value name="State.$Mode" exact="$Mode"/>
      <set_value name="State.$Origin" exact="$Origin"/>
      <set_value name="State.$OriginCode" exact="$OriginCode"/>
      <set_value name="State.$Issued" exact="true"/>
      <teleport_player object="$Target" control="false" instant="true" force="true"/>
      <set_value name="$Status" exact="'DISPATCHED'"/>
     </do_else>
    </do_elseif>
    <include_actions ref="Reply"/>
   </actions>
  </cue>

  <library name="Inspect">
   <actions>
    <set_value name="$Request" exact="event.param3"/>
    <set_value name="$Nonce" exact="@$Request.$nonce"/>
    <set_value name="$Status" exact="'HQ_MISSING'"/>
    <set_value name="$Mode" exact="'NONE'"/>
    <set_value name="$Target" exact="null"/>
    <set_value name="$AtTarget" exact="false"/>
    <set_value name="$Room" exact="null"/>
    <set_value name="$Origin" exact="if @player.controlled.isclass.ship then player.controlled else @player.occupiedship"/>
    <set_value name="$OriginCode" exact="if @$Origin.isclass.ship then $Origin.idcode else '0'"/>
    <do_if value="@State.$Issued">
     <set_value name="$Origin" exact="@State.$Origin"/>
     <set_value name="$OriginCode" exact="State.$OriginCode"/>
    </do_if>

    <set_value name="$Candidate" exact="@player.headquarters"/>
    <do_if value="@$Candidate.exists">
     <set_value name="$Status" exact="'HQ_UNAVAILABLE'"/>
     <do_if value="$Candidate.owner == faction.player and $Candidate.trueowner == faction.player and $Candidate.macro == macro.station_pla_headquarters_base_01_macro">
      <include_actions ref="InspectDock"/>
      <do_if value="$Usable">
       <set_value name="$Target" exact="$Candidate"/>
       <set_value name="$Mode" exact="'HQ'"/>
      </do_if>
      <do_else>
       <set_value name="$Status" exact="'HQ_NO_WALKABLE_DOCK'"/>
      </do_else>
     </do_if>
    </do_if>
    <do_if value="not $Target">
     <include_actions ref="SelectFallback"/>
    </do_if>
    <do_if value="$Target">
     <set_value name="$Status" exact="'READY'"/>
     <do_if value="@State.$Issued">
      <do_if value="$Mode != State.$Mode or $Target != @State.$Target or $Target.idcode != State.$Code or $Target.sector.macro.id != State.$SectorMacro or $Target.macro.id != State.$StationMacro or $Target.trueowner.id != State.$OwnerID">
       <set_value name="$Status" exact="'TARGET_CHANGED'"/>
      </do_if>
     </do_if>
     <do_if value="$Status == 'READY' and player.station == $Target and player.entity.hascontext.{$Target} and not player.controlled and not player.occupiedship and @player.room.exists">
      <set_value name="$Room" exact="player.room"/>
      <do_if value="@$Room.macro.id and ($Room.isclass.dockingbay or @$Room.parent.isclass.walkablemodule or @$Room.dynamicinterior.object == $Target)">
       <set_value name="$AtTarget" exact="true"/>
      </do_if>
     </do_if>
    </do_if>
   </actions>
  </library>

  <library name="InspectDock">
   <actions>
    <set_value name="$Usable" exact="false"/>
    <do_if value="@$Candidate.isclass.station and $Candidate.isoperational and @$Candidate.sector.isclass.sector and @$Candidate.idcode">
     <find_dockingbay name="$Dock" object="$Candidate" checkoperational="true" walkable="true" multiple="false" required="false">
      <match_dock walkable="true" storage="false"/>
     </find_dockingbay>
     <set_value name="$Usable" exact="@$Dock.exists"/>
    </do_if>
   </actions>
  </library>

  <library name="SelectFallback">
   <actions>
    <set_value name="$SectorMacro" exact="@$Request.$fallback_sector"/>
    <set_value name="$Codes" exact="@$Request.$fallback_codes"/>
    <set_value name="$Macros" exact="@$Request.$fallback_macros"/>
    <set_value name="$RequiredOwner" exact="@$Request.$fallback_owner"/>
    <do_if value="@State.$Issued and State.$Mode == 'FALLBACK'">
     <set_value name="$SectorMacro" exact="State.$SectorMacro"/>
     <set_value name="$Codes" exact="[State.$Code]"/>
     <set_value name="$Macros" exact="[State.$StationMacro]"/>
     <set_value name="$RequiredOwner" exact="State.$OwnerID"/>
    </do_if>
    <do_if value="$SectorMacro and $RequiredOwner and @$Codes.count gt 0 and $Codes.count le 8 and @$Macros.count == $Codes.count">
     <set_value name="$Status" exact="'FALLBACK_UNAVAILABLE'"/>
     <find_sector name="$Sectors" space="player.galaxy" multiple="true" required="false"/>
     <set_value name="$SectorMatches" exact="0"/>
     <do_for_each name="$Sector" in="$Sectors">
      <do_if value="$Sector.macro.id == $SectorMacro">
       <set_value name="$PreferredSector" exact="$Sector"/>
       <set_value name="$SectorMatches" operation="add"/>
      </do_if>
     </do_for_each>
     <do_if value="$SectorMatches == 1">
      <find_station name="$Stations" space="$PreferredSector" functional="true" checkoperational="true" multiple="true" required="false">
       <match_relation_to faction="faction.player" relation="neutral" comparison="ge"/>
       <match_relation_of faction="faction.player" relation="neutral" comparison="ge"/>
      </find_station>
      <do_all exact="$Codes.count" counter="$Choice">
       <set_value name="$Code" exact="$Codes.{$Choice}"/>
       <set_value name="$StationMacro" exact="$Macros.{$Choice}"/>
       <set_value name="$Matches" exact="0"/>
       <do_for_each name="$Station" in="$Stations">
        <do_if value="$Station.idcode == $Code">
         <set_value name="$Candidate" exact="$Station"/>
         <set_value name="$Matches" operation="add"/>
        </do_if>
       </do_for_each>
       <do_if value="$Matches == 1">
        <do_if value="$Candidate.trueowner != faction.ownerless and $Candidate.trueowner.id == $RequiredOwner and $Candidate.owner == $Candidate.trueowner and $Candidate.macro.id == $StationMacro">
         <include_actions ref="InspectDock"/>
         <do_if value="$Usable and @$Origin.isclass.ship">
          <set_value name="$Usable" exact="@$Candidate.dockingallowed.{$Origin}"/>
         </do_if>
         <do_if value="$Usable">
          <set_value name="$Target" exact="$Candidate"/>
          <set_value name="$Mode" exact="'FALLBACK'"/>
          <break/>
         </do_if>
        </do_if>
       </do_if>
      </do_all>
     </do_if>
    </do_if>
   </actions>
  </library>

  <library name="Reply">
   <actions>
    <do_if value="typeof $Nonce == datatype.string and $Nonce">
     <set_value name="$StationRef" exact="if $Target then '%s'.[$Target] else '0'"/>
     <set_value name="$StationCode" exact="if $Target then $Target.idcode else '0'"/>
     <set_value name="$SectorRef" exact="if $Target then '%s'.[$Target.sector] else '0'"/>
     <set_value name="$SelectedMacro" exact="if $Target then $Target.sector.macro.id else '0'"/>
     <set_value name="$RoomRef" exact="if $Room then '%s'.[$Room] else '0'"/>
     <set_value name="$RoomMacro" exact="if @$Room.macro.id then $Room.macro.id else '0'"/>
     <set_value name="$OriginRef" exact="if @$Origin.isclass.ship then '%s'.[$Origin] else '0'"/>
     <raise_lua_event name="'X4AuthorityStationParking.Result'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$Nonce,$Operation,$Status,$Mode,$StationRef,$StationCode,$SectorRef,$SelectedMacro,$RoomRef,$OriginRef,$OriginCode,$RoomMacro]"/>
    </do_if>
   </actions>
  </library>
 </cues>
</mdscript>
