<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable opt-in native Windows X4 9.00 setup and independent readback for the cockpit health receiver.
     Every cue needs an explicit UI-triggered event from the test driver. Setup registers the player's
     occupied ship as Company index 1 in the test-only ship registry. Readback and Trace read the ship
     through MD properties, independent of the receiver's Lua GetComponentData read. Trace only observes
     the receiver's own UI commands and never answers them. -->
<mdscript name="X4AuthorityCockpitHealthProbe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Setup" instantiate="true" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityCockpitHealthProbe'" control="'Setup'"/></conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <set_value name="$own" exact="player.occupiedship"/>
    <do_if value="@$r.$epoch == @md.X4AuthorityShipRegistry.State.$epoch and not @md.X4AuthorityShipRegistry.State.$faulted
       and @$own.isclass.ship and $own.isoperational and $own == player.controlled and $own == player.container
       and $own == player.ship and $own.owner == faction.player and $own.trueowner == faction.player
       and not $own.isinternallystored and $own.hull gt 0 and $own.maxshield gt 0">
     <set_value name="md.X4AuthorityShipRegistry.State.$ships" exact="table[]"/>
     <set_value name="md.X4AuthorityShipRegistry.State.$byship" exact="table[]"/>
     <set_value name="md.X4AuthorityShipRegistry.State.$ships.{1}" exact="$own"/>
     <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$own}" exact="1"/>
     <set_value name="md.X4AuthorityShipRegistry.State.$last" exact="1"/>
     <raise_lua_event name="'X4AuthorityCockpitHealthProbe.Result'" param="'%s|Ready|%s|%s|%s|%s|%s|%s|%s|%s'.[$r.$request_id,$own,$own.idcode,$own.macro.id,$own.sector.macro.id,$own.shield,$own.maxshield,$own.hull,$own.maxhull]"/>
    </do_if>
    <do_else>
     <raise_lua_event name="'X4AuthorityCockpitHealthProbe.Result'" param="'%s|Refused|setup'.[@$r.$request_id]"/>
    </do_else>
   </actions>
  </cue>

  <cue name="Readback" instantiate="true" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityCockpitHealthProbe'" control="'Readback'"/></conditions>
   <actions>
    <set_value name="$r" exact="event.param3"/>
    <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{1}"/>
    <debug_text text="'[X4LAN] AUTH_COCKPIT_HEALTH_READBACK tag=%s age=%s ship=%s occupied=%s operational=%s shield=%s maxshield=%s hull=%s maxhull=%s shieldpct=%s hullpct=%s'.[@$r.$tag,player.age / 1s,$ship,@$ship == player.occupiedship,@$ship.isoperational,@$ship.shield,@$ship.maxshield,@$ship.hull,@$ship.maxhull,@$ship.shieldpercentage,@$ship.hullpercentage]"/>
   </actions>
  </cue>

  <cue name="Trace" instantiate="true" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityCompanyCockpitHealth'"/></conditions>
   <actions>
    <set_value name="$a" exact="event.param3"/>
    <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{1}"/>
    <debug_text text="'[X4LAN] AUTH_COCKPIT_HEALTH_TRACE age=%s control=%s request=%s window=%s sequence=%s target_shield=%s target_hull=%s shield=%s hull=%s'.[player.age / 1s,event.param2,@$a.$request,@$a.$window,@$a.$sequence,@$a.$shield,@$a.$hull,@$ship.shield,@$ship.hull]"/>
   </actions>
  </cue>
 </cues>
</mdscript>
