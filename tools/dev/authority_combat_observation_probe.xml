<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable native Windows X4 9.00 scenario fixture for read-only combat observation.
     Sets up registered Company Pulsars (exact human-flight x4lan_company_pulsar loadout) and
     NPC ships in clear space (y=100 km), and drives real in-game weapon fire while the separate
     reusable read-only X4AuthorityCombatObserver records all native combat events. -->
<mdscript name="X4AuthorityCombatProbe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State">
   <actions>
    <set_value name="State.$ready" exact="false"/>
    <set_value name="State.$sector" exact="null"/>
    <set_value name="State.$helper" exact="null"/>
    <set_value name="State.$ships" exact="table[]"/>
   </actions>
   <cues>
    <cue name="Setup" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatProbe'" control="'Setup'"/></conditions>
     <actions>
      <set_value name="$r" exact="event.param3"/>
      <set_value name="$epoch" exact="@$r.$epoch"/>
      <set_value name="$req" exact="@$r.$request_id"/>
      <do_if value="$req? and $epoch? and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$epoch == $epoch and not @md.X4AuthorityShipRegistry.State.$faulted and @player.sector.isclass.sector">
       <set_value name="$sec" exact="player.sector"/>
       <get_loadout loadout="'x4lan_company_pulsar'" macro="macro.ship_arg_s_fighter_03_a_macro" result="$pulsar_loadout"/>
       <do_if value="$pulsar_loadout">
        <!-- Ship #1: Player-piloted Company Pulsar Vanguard (exact human-flight loadout). -->
        <create_ship name="$p1" macro="macro.ship_arg_s_fighter_03_a_macro" sector="$sec" seed="8401">
         <owner exact="faction.player" overridenpc="true"/>
         <loadout loadout="$pulsar_loadout"/>
         <position x="0m" y="100km" z="0m"/>
         <rotation yaw="0deg" pitch="0deg" roll="0deg"/>
        </create_ship>
        <!-- Ship #2: Unoccupied registered Company Pulsar Vanguard (same-Company FF target, 200 m ahead broadside).
             The overlap scenario may name another test loadout for it to give the second shooter a different gun. -->
        <set_value name="$p2_loadout" exact="$pulsar_loadout"/>
        <do_if value="$r.$second_loadout?">
         <get_loadout loadout="$r.$second_loadout" macro="macro.ship_arg_s_fighter_03_a_macro" result="$p2_loadout"/>
        </do_if>
        <create_ship name="$p2" macro="macro.ship_arg_s_fighter_03_a_macro" sector="$sec" seed="8402">
         <owner exact="faction.player" overridenpc="true"/>
         <loadout loadout="$p2_loadout"/>
         <position x="0m" y="100km" z="200m"/>
         <rotation yaw="90deg" pitch="0deg" roll="0deg"/>
        </create_ship>
        <!-- Ship #3: Unoccupied registered Company Pulsar Vanguard (isolated 6 km away for hostile NPC->Company case). -->
        <create_ship name="$p3" macro="macro.ship_arg_s_fighter_03_a_macro" sector="$sec" seed="8403">
         <owner exact="faction.player" overridenpc="true"/>
         <loadout loadout="$pulsar_loadout"/>
         <position x="6km" y="100km" z="0m"/>
         <rotation yaw="90deg" pitch="0deg" roll="0deg"/>
        </create_ship>
        <!-- Ship #4: NPC target (Xenon S fighter with Wait order, isolated at x=-6 km for Case 3). -->
        <create_ship name="$npc_target" macro="macro.ship_xen_s_fighter_01_a_macro" sector="$sec" seed="8404">
         <owner exact="faction.xenon" overridenpc="true"/>
         <loadout><level exact="1.0"/><variation exact="0"/></loadout>
         <pilot><select faction="faction.xenon" tags="tag.pilot"/></pilot>
         <position x="-6km" y="100km" z="0m"/>
         <rotation yaw="90deg" pitch="0deg" roll="0deg"/>
        </create_ship>
        <!-- Ship #5: Hostile NPC attacker (Xenon S fighter, 280 m from Company #3 facing it). -->
        <create_ship name="$npc_att" macro="macro.ship_xen_s_fighter_01_a_macro" sector="$sec" seed="8405">
         <owner exact="faction.xenon" overridenpc="true"/>
         <loadout><level exact="1.0"/><variation exact="0"/></loadout>
         <pilot><select faction="faction.xenon" tags="tag.pilot"/></pilot>
         <position x="6km" y="100km" z="-280m"/>
         <rotation yaw="0deg" pitch="0deg" roll="0deg"/>
        </create_ship>
        <!-- Distant helper ship whose AI pilot can invoke shoot_at on $p1 without entering combat. -->
        <create_ship name="$helper" macro="macro.ship_arg_s_scout_01_a_macro" sector="$sec" seed="8409">
         <owner exact="faction.argon" overridenpc="true"/>
         <loadout><level exact="0.0"/><variation exact="0"/></loadout>
         <pilot><select faction="faction.argon" tags="tag.aipilot"/></pilot>
         <position x="35km" y="100km" z="0m"/>
        </create_ship>

        <do_if value="@$p1.isoperational and @$p2.isoperational and @$p3.isoperational and @$npc_target.isoperational and @$npc_att.isoperational and @$helper.isoperational">
         <create_order object="$npc_target" id="'Wait'" default="true">
          <param name="noattackresponse" value="true"/>
         </create_order>
         <create_order object="$npc_att" id="'Wait'" default="true">
          <param name="noattackresponse" value="true"/>
         </create_order>
         <create_order object="$helper" id="'Wait'" default="true">
          <param name="noattackresponse" value="true"/>
         </create_order>

         <!-- Seat the real local player into Company Pulsar #1 and ensure weapon group 0 primary is active. -->
         <teleport_player object="$p1" control="true" instant="true" force="true"/>
         <reset_weapongroups object="$p1"/>
         <activate_weapongroup object="$p1" weapongroup="0" primary="true"/>

         <!-- Enroll all 5 scenario ships into X4AuthorityShipRegistry (1-3 Company player-owned, 4-5 Xenon NPC). -->
         <set_value name="md.X4AuthorityShipRegistry.State.$ships" exact="table[]"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship" exact="table[]"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$ships.{1}" exact="$p1"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$p1}" exact="1"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$ships.{2}" exact="$p2"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$p2}" exact="2"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$ships.{3}" exact="$p3"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$p3}" exact="3"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$ships.{4}" exact="$npc_target"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$npc_target}" exact="4"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$ships.{5}" exact="$npc_att"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$byship.{$npc_att}" exact="5"/>
         <set_value name="md.X4AuthorityShipRegistry.State.$last" exact="5"/>

         <set_value name="State.$sector" exact="$sec"/>
         <set_value name="State.$helper" exact="$helper"/>
         <set_value name="State.$ships.{1}" exact="$p1"/>
         <set_value name="State.$ships.{2}" exact="$p2"/>
         <set_value name="State.$ships.{3}" exact="$p3"/>
         <set_value name="State.$ships.{4}" exact="$npc_target"/>
         <set_value name="State.$ships.{5}" exact="$npc_att"/>
         <set_value name="State.$ready" exact="true"/>

         <debug_text text="'[X4LAN] AUTH_COMBAT_PROBE setup_ok sector=%s p1=%s(%s,w=%s) p2=%s(%s) p3=%s(%s) npc_target=%s(%s) npc_att=%s(%s,w=%s)'.[$sec.macro.id,$p1,$p1.idcode,$p1.weapons.operational.count,$p2,$p2.idcode,$p3,$p3.idcode,$npc_target,$npc_target.idcode,$npc_att,$npc_att.idcode,$npc_att.weapons.operational.count]"/>
         <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Ready|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$req,$sec.macro.id,$p1,$p1.idcode,$p2,$p2.idcode,$p3,$p3.idcode,$npc_target,$npc_target.idcode,$npc_att,$npc_att.idcode]"/>
        </do_if>
        <do_else>
         <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Refused|spawn_failed'.[$req]"/>
        </do_else>
       </do_if>
       <do_else>
        <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Refused|loadout_missing'.[$req]"/>
       </do_else>
      </do_if>
      <do_else>
       <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Refused|precondition'.[@$req]"/>
      </do_else>
     </actions>
    </cue>

    <cue name="Phase" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatProbe'" control="'Phase'"/></conditions>
     <actions>
      <set_value name="$r" exact="event.param3"/>
      <debug_text text="'[X4LAN] AUTH_COMBAT_PHASE phase=%s age=%s'.[@$r.$phase,player.age / 1s]"/>
      <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Phase|%s'.[@$r.$request_id,@$r.$phase]"/>
     </actions>
    </cue>

    <cue name="Reposition" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatProbe'" control="'Reposition'"/></conditions>
     <actions>
      <set_value name="$r" exact="event.param3"/>
      <set_value name="$ship" exact="@State.$ships.{$r.$index}"/>
      <do_if value="State.$ready and @$ship.isoperational and State.$sector.isclass.sector">
       <warp object="$ship" sector="State.$sector">
        <position x="($r.$x)m" y="($r.$y)m" z="($r.$z)m"/>
        <rotation yaw="($r.$yaw)deg" pitch="0deg" roll="0deg"/>
       </warp>
       <debug_text text="'[X4LAN] AUTH_COMBAT_PROBE reposition index=%s ship=%s x=%s y=%s z=%s yaw=%s'.[$r.$index,$ship,$r.$x,$r.$y,$r.$z,$r.$yaw]"/>
       <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Repositioned|%s'.[@$r.$request_id,$r.$index]"/>
      </do_if>
      <do_else>
       <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Refused|reposition'.[@$r.$request_id]"/>
      </do_else>
     </actions>
    </cue>

    <cue name="FireControl" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatProbe'" control="'FireControl'"/></conditions>
     <actions>
      <set_value name="$r" exact="event.param3"/>
      <set_value name="$mode" exact="@$r.$mode"/>
      <set_value name="$shooter" exact="@State.$ships.{$r.$shooter}"/>
      <set_value name="$target" exact="if $r.$target? then @State.$ships.{$r.$target} else null"/>
      <do_if value="State.$ready and @$shooter.isoperational">
       <do_if value="$mode == 'shoot_at' and @$target.isoperational and @State.$helper.pilot.exists">
        <stop_shooting object="$shooter"/>
        <reset_weapongroups object="$shooter"/>
        <activate_weapongroup object="$shooter" weapongroup="0" primary="true"/>
        <set_value name="$dur" exact="if $r.$duration? then ($r.$duration)s else 5s"/>
        <start_script object="State.$helper.pilot" name="'x4neon.combat.shoot_at'">
         <param name="ship" value="$shooter"/>
         <param name="target" value="$target"/>
         <param name="duration" value="$dur"/>
        </start_script>
        <debug_text text="'[X4LAN] AUTH_COMBAT_PROBE fire mode=shoot_at shooter=%s target=%s dur=%s'.[$r.$shooter,$r.$target,$dur]"/>
        <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Fired|shoot_at'.[@$r.$request_id]"/>
       </do_if>
       <do_elseif value="$mode == 'mindless_shoot'">
        <stop_shooting object="$shooter"/>
        <reset_weapongroups object="$shooter"/>
        <activate_weapongroup object="$shooter" weapongroup="0" primary="true"/>
        <shoot object="$shooter" primary="true"/>
        <debug_text text="'[X4LAN] AUTH_COMBAT_PROBE fire mode=mindless_shoot shooter=%s'.[$r.$shooter]"/>
        <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Fired|mindless_shoot'.[@$r.$request_id]"/>
       </do_elseif>
       <do_elseif value="$mode == 'ai_attack' and @$target.isoperational">
        <cancel_all_orders object="$shooter"/>
        <create_order object="$shooter" id="'Attack'" immediate="true">
         <param name="primarytarget" value="$target"/>
         <param name="pursuetargets" value="true"/>
         <param name="allowothertargets" value="false"/>
        </create_order>
        <debug_text text="'[X4LAN] AUTH_COMBAT_PROBE fire mode=ai_attack shooter=%s target=%s'.[$r.$shooter,$r.$target]"/>
        <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Fired|ai_attack'.[@$r.$request_id]"/>
       </do_elseif>
       <do_elseif value="$mode == 'stop'">
        <stop_shooting object="$shooter"/>
        <do_if value="$r.$shooter != 1">
         <cancel_all_orders object="$shooter"/>
         <create_order object="$shooter" id="'Wait'" immediate="true">
          <param name="noattackresponse" value="true"/>
         </create_order>
        </do_if>
        <debug_text text="'[X4LAN] AUTH_COMBAT_PROBE fire mode=stop shooter=%s'.[$r.$shooter]"/>
        <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Stopped|%s'.[@$r.$request_id,$r.$shooter]"/>
       </do_elseif>
       <do_else>
        <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Refused|fire_mode'.[@$r.$request_id]"/>
       </do_else>
      </do_if>
      <do_else>
       <raise_lua_event name="'X4AuthorityCombatProbe.Result'" param="'%s|Refused|fire_shooter'.[@$r.$request_id]"/>
      </do_else>
     </actions>
    </cue>
   </cues>
  </cue>
 </cues>
</mdscript>
