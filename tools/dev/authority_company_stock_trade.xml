<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in disposable authority fixture. No paths from the multiplayer wire. -->
<mdscript name="X4AuthorityCompanyStockTrade" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="State">
      <actions><set_value name="$attempted" exact="false"/></actions>
      <cues>
        <cue name="Request" instantiate="true">
          <conditions>
            <check_any>
              <event_ui_triggered screen="'X4AuthorityCompanyStockTrade'" control="'Quote'"/>
              <event_ui_triggered screen="'X4AuthorityCompanyStockTrade'" control="'Buy'"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$v" exact="event.param3"/>
            <set_value name="$request" exact="@$v.$request_id"/>
            <set_value name="$status" exact="'invalid_registry'"/>
            <set_value name="$quote" exact="0"/>
            <set_value name="$trial" exact="if @$v.$trial then $v.$trial else 'one_unit'"/>
            <set_value name="$quantity" exact="if $trial == 'six_unit' then 6 else 1"/>
            <set_value name="$fixed" exact="@$v.$fixed_request == true"/>
            <do_if value="typeof $request == datatype.string and $request and ($trial == 'one_unit' or $trial == 'six_unit') and @$v.$epoch and md.X4AuthorityShipRegistry.State.$epoch? and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted">
              <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{7354}"/>
              <set_value name="$station" exact="@$ship.dock.container"/>
              <set_value name="$parking" exact="player.station"/>
              <set_value name="$ware" exact="ware.water"/>
              <set_value name="$status" exact="'invalid_fixture'"/>
              <do_if value="@$ship.isclass.ship and $ship.isoperational and $ship.pilot and $ship.pilot != player.entity and $ship.owner == faction.player and $ship.idcode == 'WRN-302' and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == 7354 and $ship != player.ship and $ship != player.container and @$station.isclass.station and $station.isoperational and $station.owner == faction.teladi and $station.idcode == 'BIM-169' and @$parking.isclass.station and $parking.idcode == 'XPJ-169' and $parking != $station and player.entity.hascontext.{$parking} and not player.controlled and not player.occupiedship and @player.room.exists and @$ship.dock.istradingallowed">
                <do_if value="$fixed and (@$v.$sector != @$station.sector.macro.id or @$v.$station_code != $station.idcode or @$v.$ship_code != $ship.idcode or @$v.$ware != $ware.id or @$v.$quantity != $quantity or not @$v.$price_cents or $v.$price_cents le 0 or $v.$price_cents gt 2147483647 or ($v.$price_cents)L != $v.$price_cents)">
                  <set_value name="$status" exact="'request_binding_invalid'"/>
                </do_if>
                <do_elseif value="event.param2 == 'Buy' and (@State.$attempted or @State.$refused)">
                  <set_value name="$status" exact="'already_attempted'"/>
                </do_elseif>
                <do_else>
                  <set_value name="$status" exact="'no_unique_offer'"/>
                  <find_sell_offer result="$offers" multiple="true" tradepartner="$ship" seller="$station" wares="$ware" excludemissions="true"/>
                  <do_if value="$offers.count == 1">
                    <set_value name="$offer" exact="$offers.{1}"/>
                    <set_value name="$price" exact="$offer.unitprice"/>
                    <set_value name="$quote" exact="($price / 1ct)L"/>
                    <set_value name="$fresh_quote_time" exact="player.age / 1s"/>
                    <do_if value="event.param2 == 'Buy' and $fixed and $quote gt 0">
                      <raise_lua_event name="'X4AuthorityCompanyStockTrade.Result'" param="'%s|quote|%s'.[$request,$quote]"/>
                    </do_if>
                    <do_if value="event.param2 == 'Buy' and not $fixed and (@State.$quoted_request != $request or @State.$quoted_epoch != $v.$epoch or @State.$quoted_trial != $trial)">
                      <set_value name="$status" exact="'quote_required'"/>
                    </do_if>
                    <do_elseif value="event.param2 == 'Buy' and $fixed and $quote gt 0 and $v.$price_cents * 1ct != $price">
                      <set_value name="$status" exact="'refusal_unverified'"/>
                      <set_value name="$refusal_water_before" exact="$ship.cargo.{$ware}.count"/>
                      <set_value name="$refusal_cash_before" exact="(player.money / 1ct)L"/>
                      <set_value name="$refusal_faction_before" exact="if faction.player.hasownaccount then (faction.player.money / 1ct)L else -1"/>
                      <set_value name="$refusal_orders_before" exact="$ship.orders.count"/>
                      <set_value name="State.$refused" exact="true"/>
                      <set_value name="$refusal_water_after" exact="$ship.cargo.{$ware}.count"/>
                      <set_value name="$refusal_cash_after" exact="(player.money / 1ct)L"/>
                      <do_if value="not @State.$order and not @State.$deal and $ship.orders.count == $refusal_orders_before and $refusal_water_before ge 0 and $refusal_water_before == $refusal_water_after and $refusal_cash_before ge 0 and $refusal_cash_before == $refusal_faction_before and $refusal_cash_before == $refusal_cash_after and faction.player.hasownaccount and faction.player.money == player.money">
                        <set_value name="$status" exact="'price_changed'"/>
                        <raise_lua_event name="'X4AuthorityCompanyStockTrade.Refused'" param="'%s|price_changed|%s|%s|%s|%s|%s|%s'.[$request,($v.$price_cents)L,$quote,$refusal_water_before,$refusal_water_after,$refusal_cash_before,$refusal_cash_after]"/>
                      </do_if>
                    </do_elseif>
                    <do_else>
                      <clamp_trade_amount result="$amount" trade="$offer" amount="$quantity" buyer="$ship" seller="$station" unbundle="false"/>
                      <set_value name="$tradeable" exact="$price gt 0Cr and $amount == $quantity and $offer.offeramount.{$ship} ge $quantity and $ship.money ge ($price * $quantity) and player.money ge ($price * $quantity)"/>
                      <set_value name="$status" exact="'not_tradeable'"/>
                      <do_if value="event.param2 == 'Quote' and not $fixed and $tradeable">
                        <set_value name="$status" exact="'quote'"/>
                        <set_value name="State.$quoted_request" exact="$request"/>
                        <set_value name="State.$quoted_epoch" exact="$v.$epoch"/>
                        <set_value name="State.$quoted_price" exact="$price"/>
                        <set_value name="State.$quoted_trial" exact="$trial"/>
                        <set_value name="State.$quoted_at" exact="$fresh_quote_time"/>
                      </do_if>
                      <do_elseif value="event.param2 == 'Buy' and $tradeable">
                        <do_if value="(not $fixed and State.$quoted_price != $price) or not @$v.$price_cents or $v.$price_cents * 1ct != $price">
                          <set_value name="$status" exact="'price_changed'"/>
                        </do_if>
                        <do_else>
                          <set_value name="State.$attempted" exact="true"/>
                          <set_value name="State.$request" exact="$request"/>
                          <set_value name="State.$epoch" exact="$v.$epoch"/>
                          <set_value name="State.$trial" exact="$trial"/>
                          <set_value name="State.$quantity" exact="$quantity"/>
                          <set_value name="State.$quote_time" exact="if $fixed then $fresh_quote_time else State.$quoted_at"/>
                          <set_value name="State.$ship" exact="$ship"/>
                          <set_value name="State.$station" exact="$station"/>
                          <set_value name="State.$parking" exact="$parking"/>
                          <set_value name="State.$ware" exact="$ware"/>
                          <set_value name="State.$price" exact="$price"/>
                          <set_value name="State.$before_ship_cargo" exact="$ship.cargo.{$ware}.count"/>
                          <set_value name="State.$before_station_cargo" exact="$station.cargo.{$ware}.count"/>
                          <set_value name="State.$before_ship_money" exact="$ship.money"/>
                          <set_value name="State.$before_station_money" exact="$station.money"/>
                          <set_value name="State.$before_player_money" exact="player.money"/>
                          <set_value name="State.$before_faction_has_account" exact="faction.player.hasownaccount"/>
                          <set_value name="State.$before_faction_money" exact="if State.$before_faction_has_account then (faction.player.money / 1ct)L else 'unknown'"/>
                          <signal_cue_instantly cue="Monitor"/>
                          <create_trade_order name="State.$order" object="$ship" tradeoffer="$offer" amount="$quantity" price="$price" bundle="false" unbundle="false" immediate="true"/>
                          <set_value name="State.$deal" exact="@State.$order.trade"/>
                          <set_value name="$status" exact="if @State.$deal then 'submitted' else 'order_refused'"/>
                        </do_else>
                      </do_elseif>
                    </do_else>
                  </do_if>
                </do_else>
              </do_if>
            </do_if>
            <raise_lua_event name="'X4AuthorityCompanyStockTrade.Result'" param="'%s|%s|%s'.[$request,$status,$quote]"/>
          </actions>
        </cue>
        <cue name="Monitor">
          <conditions><event_cue_signalled/></conditions>
          <cues>
            <cue name="Completed" instantiate="true">
              <conditions>
                <event_trade_completed buyer="State.$ship" seller="State.$station" ware="State.$ware"/>
                <check_value value="@State.$deal and (event.param == State.$deal or event.param2 == State.$deal) and not State.$completion_seen?"/>
              </conditions>
              <actions>
                <set_value name="State.$completion_seen" exact="true"/>
                <set_value name="$after_ship_cargo" exact="State.$ship.cargo.{State.$ware}.count"/>
                <set_value name="$delta_ship_cargo" exact="$after_ship_cargo - State.$before_ship_cargo"/>
                <set_value name="$delta_station_cargo" exact="State.$station.cargo.{State.$ware}.count - State.$before_station_cargo"/>
                <set_value name="$delta_ship_money" exact="((State.$ship.money - State.$before_ship_money) / 1ct)L"/>
                <set_value name="$delta_station_money" exact="((State.$station.money - State.$before_station_money) / 1ct)L"/>
                <set_value name="$delta_player_money" exact="((player.money - State.$before_player_money) / 1ct)L"/>
                <set_value name="$docked" exact="@State.$ship.dock.container == State.$station"/>
                <set_value name="$parked" exact="player.station == State.$parking and not player.controlled and not player.occupiedship and @player.room.exists"/>
                <do_if value="event.param == State.$deal and event.param.buyer == State.$ship and event.param.seller == State.$station and event.param.ware == State.$ware">
                  <set_value name="$completed" exact="event.param"/>
                  <set_value name="$after_player_money" exact="(player.money / 1ct)L"/>
                  <set_value name="$after_faction_has_account" exact="faction.player.hasownaccount"/>
                  <set_value name="$after_faction_money" exact="if $after_faction_has_account then (faction.player.money / 1ct)L else 'unknown'"/>
                  <raise_lua_event name="'X4AuthorityCompanyStockTrade.Deal'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[State.$request,State.$epoch,State.$trial,State.$quantity,(State.$price / 1ct)L,State.$quote_time,player.age / 1s,$completed.buyer,$completed.seller,$completed.ware.id,$completed.transferredamount,$completed.destroyedamount,($completed.unitprice / 1ct)L,(($completed.unitprice * $completed.transferredamount) / 1ct)L,(State.$before_player_money / 1ct)L,$after_player_money,if State.$before_faction_has_account then 1 else 0,if $after_faction_has_account then 1 else 0,State.$before_faction_money,$after_faction_money,State.$before_ship_cargo,$after_ship_cargo]"/>
                </do_if>
                <raise_lua_event name="'X4AuthorityCompanyStockTrade.Observed'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s'.[State.$request,(State.$price / 1ct)L,$delta_ship_cargo,$delta_station_cargo,$delta_ship_money,$delta_station_money,$delta_player_money,$docked,$parked]"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
