<?xml version="1.0" encoding="utf-8"?>
<!-- Staged only in explicitly opted-in provider overlays. -->
<mdscript name="X4AuthorityCompanyStockTrade" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="State">
      <actions><set_value name="$attempted" exact="false"/></actions>
      <cues>
        <cue name="Request" instantiate="true" namespace="this">
          <conditions>
            <check_any>
              <event_ui_triggered screen="'X4AuthorityCompanyStockTrade'" control="'Quote'"/>
              <event_ui_triggered screen="'X4AuthorityCompanyStockTrade'" control="'Buy'"/>
            </check_any>
          </conditions>
          <actions>
            <set_value name="$v" exact="event.param3"/>
            <set_value name="$request" exact="@$v.$request_id"/>
            <set_value name="$status" exact="'invalid_registry'"/>
            <set_value name="$quote" exact="0"/>
            <set_value name="$trial" exact="if @$v.$trial then $v.$trial else 'one_unit'"/>
            <set_value name="$fixed" exact="@$v.$fixed_request == true"/>
            <set_value name="$live" exact="@$v.$live_request == true"/>
            <set_value name="$provider_lease" exact="@$v.$provider_lease"/>
            <set_value name="$live_request_valid" exact="not $live or ($trial == 'live_purchase' and $fixed and event.param2 == 'Buy'
                and typeof $provider_lease == datatype.string and $provider_lease
                and typeof @$v.$previous_confirmed == datatype.string
                and @$v.$ship_index ge 1 and @$v.$ship_index le 2147483647 and ($v.$ship_index)i == $v.$ship_index
                and @$v.$quantity ge 1 and @$v.$quantity le 65535 and ($v.$quantity)i == $v.$quantity
                and typeof @$v.$ware == datatype.string and typeof @ware.{$v.$ware} == datatype.ware)"/>
            <do_if value="not $live_request_valid">
              <set_value name="$status" exact="'request_binding_invalid'"/>
            </do_if>
            <do_elseif value="typeof $request == datatype.string and $request and ($live or $trial == 'one_unit' or $trial == 'six_unit') and @$v.$epoch and md.X4AuthorityShipRegistry.State.$epoch? and $v.$epoch == md.X4AuthorityShipRegistry.State.$epoch and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted">
              <!-- Retain the original fixed subjects for the isolated quote and purchase diagnostics. -->
              <set_value name="$index" exact="if $live then $v.$ship_index else 7354"/>
              <set_value name="$quantity" exact="if $live then $v.$quantity else (if $trial == 'six_unit' then 6 else 1)"/>
              <set_value name="$ware" exact="if $live then ware.{$v.$ware} else ware.water"/>
              <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
              <set_value name="$station" exact="@$ship.dock.container"/>
              <set_value name="$parking" exact="player.station"/>
              <set_value name="$status" exact="if $live then 'dock_mismatch' else 'invalid_fixture'"/>
              <set_value name="$bay" exact="@$ship.dock"/>
              <set_value name="$owned_docked" exact="@$ship.isclass.ship and $ship.isoperational
                  and $ship.owner == faction.player and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $index
                  and $ship != player.ship and $ship != player.container and @$station.isclass.station and $station.isoperational
                  and @$parking.isclass.station and player.entity.hascontext.{$parking}
                  and not player.controlled and not player.occupiedship and @player.room.exists and @$bay.istradingallowed"/>
              <set_value name="$live_dock" exact="$live and $owned_docked and @$bay.isclass.dockingbay and $bay.external and not $bay.isstorage
                  and $bay.dockstate == dockstate.default and $bay.container == $station and $bay.docked.indexof.{$ship}
                  and not $ship.isinternallystored and $ship.trueowner == faction.player
                  and $station.owner and $station.trueowner == $station.owner and $ship.sector == $station.sector"/>
              <set_value name="$fixture_dock" exact="not $live and $owned_docked and $ship.pilot and $ship.pilot != player.entity
                  and $ship.idcode == 'WRN-302' and $station.owner == faction.teladi and $station.idcode == 'BIM-169'
                  and $parking != $station and $parking.idcode == 'XPJ-169'"/>
              <do_if value="$live_dock or $fixture_dock">
                <do_if value="$fixed and (@$v.$sector != @$station.sector.macro.id or @$v.$station_code != $station.idcode or @$v.$ship_code != $ship.idcode or @$v.$ware != $ware.id or @$v.$quantity != $quantity or not @$v.$price_cents or $v.$price_cents le 0 or $v.$price_cents gt 2147483647 or ($v.$price_cents)L != $v.$price_cents)">
                  <set_value name="$status" exact="'request_binding_invalid'"/>
                </do_if>
                <!-- A new process has a new lease, even when the save retained completed cues.
                     Within this lease only the host's durable confirmation releases the last order. -->
                <do_elseif value="$live and (if $provider_lease == @State.$live_lease
                    then @$v.$previous_confirmed != @State.$live_request or @State.$live_completed != true or $request == @State.$live_request
                    else @$v.$previous_confirmed != '-')">
                  <set_value name="$status" exact="'provider_limit'"/>
                </do_elseif>
                <do_elseif value="event.param2 == 'Buy' and not $live and (@State.$attempted or @State.$refused)">
                  <set_value name="$status" exact="'already_attempted'"/>
                </do_elseif>
                <do_elseif value="$live and (not @$ship.assignedaipilot.exists or $ship.assignedaipilot == player.entity or @$ship.assignedaipilot.owner != faction.player)">
                  <set_value name="$status" exact="'captain_required'"/>
                </do_elseif>
                <do_elseif value="$live and (not $ship.pilot or $ship.pilot != $ship.assignedaipilot
                    or $ship.orders.count != 0 or ($ship.defaultorder and $ship.defaultorder.id != 'Wait'))">
                  <set_value name="$status" exact="'dock_mismatch'"/>
                </do_elseif>
                <do_else>
                  <set_value name="$status" exact="'no_unique_offer'"/>
                  <find_sell_offer result="$offers" multiple="true" tradepartner="$ship" seller="$station" wares="$ware" excludemissions="true"/>
                  <do_if value="$offers.count == 1">
                    <set_value name="$offer" exact="$offers.{1}"/>
                    <set_value name="$price" exact="$offer.unitprice"/>
                    <set_value name="$quote" exact="($price / 1ct)L"/>
                    <set_value name="$fresh_quote_time" exact="player.age / 1s"/>
                    <do_if value="$live">
                      <raise_lua_event name="'X4AuthorityCompanyStockTrade.Bound'" param="'%s|READY|%s|%s|%s|%s'.[$request,$ship,$station,$bay,$fresh_quote_time]"/>
                    </do_if>
                    <do_if value="event.param2 == 'Buy' and $fixed and $quote gt 0">
                      <raise_lua_event name="'X4AuthorityCompanyStockTrade.Result'" param="'%s|quote|%s'.[$request,$quote]"/>
                    </do_if>
                    <do_if value="event.param2 == 'Buy' and not $fixed and (@State.$quoted_request != $request or @State.$quoted_epoch != $v.$epoch or @State.$quoted_trial != $trial)">
                      <set_value name="$status" exact="'quote_required'"/>
                    </do_if>
                    <do_elseif value="event.param2 == 'Buy' and $fixed and $quote gt 0 and $v.$price_cents * 1ct != $price">
                      <set_value name="$status" exact="'refusal_unverified'"/>
                      <set_value name="$refusal_cargo_before" exact="$ship.cargo.{$ware}.count"/>
                      <set_value name="$refusal_cash_before" exact="(player.money / 1ct)L"/>
                      <set_value name="$refusal_faction_before" exact="if faction.player.hasownaccount then (faction.player.money / 1ct)L else -1"/>
                      <set_value name="$refusal_orders_before" exact="$ship.orders.count"/>
                      <do_if value="not $live">
                        <set_value name="State.$refused" exact="true"/>
                      </do_if>
                      <set_value name="$refusal_cargo_after" exact="$ship.cargo.{$ware}.count"/>
                      <set_value name="$refusal_cash_after" exact="(player.money / 1ct)L"/>
                      <do_if value="not @$order and not @$deal and $ship.orders.count == $refusal_orders_before and $refusal_cargo_before ge 0 and $refusal_cargo_before == $refusal_cargo_after and $refusal_cash_before ge 0 and $refusal_cash_before == $refusal_faction_before and $refusal_cash_before == $refusal_cash_after and faction.player.hasownaccount and faction.player.money == player.money">
                        <set_value name="$status" exact="'price_changed'"/>
                        <raise_lua_event name="'X4AuthorityCompanyStockTrade.Refused'" param="'%s|price_changed|%s|%s|%s|%s|%s|%s'.[$request,($v.$price_cents)L,$quote,$refusal_cargo_before,$refusal_cargo_after,$refusal_cash_before,$refusal_cash_after]"/>
                      </do_if>
                    </do_elseif>
                    <do_else>
                      <clamp_trade_amount result="$amount" trade="$offer" amount="$quantity" buyer="$ship" seller="$station" bundle="false" unbundle="false"/>
                      <set_value name="$tradeable" exact="$price gt 0Cr and $amount == $quantity and $offer.offeramount.{$ship} ge $quantity and $ship.money ge ($price * $quantity) and player.money ge ($price * $quantity) and (not $live or (faction.player.hasownaccount and faction.player.money == player.money))"/>
                      <set_value name="$status" exact="'not_tradeable'"/>
                      <do_if value="event.param2 == 'Quote' and not $fixed and $tradeable">
                        <set_value name="$status" exact="'quote'"/>
                        <set_value name="State.$quoted_request" exact="$request"/>
                        <set_value name="State.$quoted_epoch" exact="$v.$epoch"/>
                        <set_value name="State.$quoted_price" exact="$price"/>
                        <set_value name="State.$quoted_trial" exact="$trial"/>
                        <set_value name="State.$quoted_at" exact="$fresh_quote_time"/>
                      </do_if>
                      <do_elseif value="event.param2 == 'Buy' and $tradeable">
                        <do_if value="(not $fixed and State.$quoted_price != $price) or not @$v.$price_cents or $v.$price_cents * 1ct != $price">
                          <set_value name="$status" exact="'price_changed'"/>
                        </do_if>
                        <do_else>
                          <!-- The Monitor path exists in earlier checkpoints. Reset only
                               its cue tree, never the X4 order queue. -->
                          <reset_cue cue="Monitor"/>
                          <set_value name="State.$monitor_ready" exact="null"/>
                          <set_value name="State.$purchase" exact="table[
                            $request=$request, $epoch=$v.$epoch, $trial=$trial, $quantity=$quantity,
                            $quote_time=if $fixed then $fresh_quote_time else State.$quoted_at,
                            $ship=$ship, $index=$index, $ship_code=$ship.idcode, $station=$station,
                            $station_code=$station.idcode, $sector=$station.sector, $parking=$parking,
                            $live=$live, $provider_lease=$provider_lease, $bay=$bay, $ware=$ware, $price=$price,
                            $before_ship_cargo=$ship.cargo.{$ware}.count, $before_station_cargo=$station.cargo.{$ware}.count,
                            $before_ship_money=$ship.money, $before_station_money=$station.money,
                            $before_player_money=player.money, $before_faction_has_account=faction.player.hasownaccount,
                            $before_faction_money=if faction.player.hasownaccount then (faction.player.money / 1ct)L else 'unknown'
                          ]"/>
                          <signal_cue_instantly cue="Monitor" param="$request"/>
                          <do_if value="@State.$monitor_ready == $request">
                            <do_if value="$live">
                              <set_value name="State.$live_lease" exact="$provider_lease"/>
                              <set_value name="State.$live_request" exact="$request"/>
                              <set_value name="State.$live_completed" exact="false"/>
                            </do_if>
                            <do_else>
                              <set_value name="State.$attempted" exact="true"/>
                            </do_else>
                            <do_if value="$live">
                              <raise_lua_event name="'X4AuthorityCompanyStockTrade.Before'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$request,$v.$epoch,$ship,$station,$bay,$ware.id,$quantity,$quote,State.$purchase.$before_ship_cargo,(State.$purchase.$before_player_money / 1ct)L,State.$purchase.$before_faction_money,$fresh_quote_time]"/>
                            </do_if>
                            <create_trade_order name="State.$purchase.$order" object="$ship" tradeoffer="$offer" amount="$quantity" price="$price" bundle="false" unbundle="false" immediate="true"/>
                            <set_value name="State.$purchase.$deal" exact="@State.$purchase.$order.trade"/>
                            <set_value name="$status" exact="if @State.$purchase.$deal then 'submitted' else 'order_refused'"/>
                          </do_if>
                          <do_else>
                            <remove_value name="State.$purchase"/>
                            <set_value name="$status" exact="'provider_limit'"/>
                          </do_else>
                        </do_else>
                      </do_elseif>
                    </do_else>
                  </do_if>
                </do_else>
              </do_if>
            </do_elseif>
            <raise_lua_event name="'X4AuthorityCompanyStockTrade.Result'" param="'%s|%s|%s'.[$request,$status,$quote]"/>
          </actions>
        </cue>
        <cue name="Monitor">
          <conditions><event_cue_signalled/></conditions>
          <actions>
            <set_value name="State.$monitor_ready" exact="event.param"/>
          </actions>
          <cues>
            <cue name="Completed" namespace="this">
              <conditions>
                <event_trade_completed buyer="@State.$purchase.$ship" seller="@State.$purchase.$station" ware="@State.$purchase.$ware"/>
                <check_value value="@State.$purchase.$deal and (event.param == State.$purchase.$deal
                    or (event.param2 == State.$purchase.$order and @event.param2.trade == State.$purchase.$deal))
                    and (not State.$purchase.$live or (State.$purchase.$provider_lease == @State.$live_lease
                    and State.$purchase.$request == @State.$live_request))"/>
              </conditions>
              <actions>
                <set_value name="$entry" exact="State.$purchase"/>
                <set_value name="$after_ship_cargo" exact="$entry.$ship.cargo.{$entry.$ware}.count"/>
                <set_value name="$delta_ship_cargo" exact="$after_ship_cargo - $entry.$before_ship_cargo"/>
                <set_value name="$delta_station_cargo" exact="$entry.$station.cargo.{$entry.$ware}.count - $entry.$before_station_cargo"/>
                <set_value name="$delta_ship_money" exact="(($entry.$ship.money - $entry.$before_ship_money) / 1ct)L"/>
                <set_value name="$delta_station_money" exact="(($entry.$station.money - $entry.$before_station_money) / 1ct)L"/>
                <set_value name="$delta_player_money" exact="((player.money - $entry.$before_player_money) / 1ct)L"/>
                <set_value name="$docked" exact="@$entry.$ship.dock.container == $entry.$station"/>
                <do_if value="$entry.$live and $docked">
                  <set_value name="$registry_bound" exact="@md.X4AuthorityShipRegistry.State.$epoch == $entry.$epoch and @md.X4AuthorityShipRegistry.State.$faulted == false
                      and @md.X4AuthorityShipRegistry.State.$ships.{$entry.$index} == $entry.$ship and @md.X4AuthorityShipRegistry.State.$byship.{$entry.$ship} == $entry.$index"/>
                  <set_value name="$docked" exact="$registry_bound and $entry.$ship.isoperational and $entry.$ship.idcode == $entry.$ship_code
                      and $entry.$ship.dock == $entry.$bay and not $entry.$ship.isinternallystored
                      and $entry.$bay.isclass.dockingbay and $entry.$bay.external and not $entry.$bay.isstorage
                      and $entry.$bay.dockstate == dockstate.default and $entry.$bay.istradingallowed
                      and $entry.$ship.owner == faction.player and $entry.$ship.trueowner == faction.player
                      and $entry.$station.isoperational and $entry.$station.idcode == $entry.$station_code
                      and $entry.$station.owner and $entry.$station.trueowner == $entry.$station.owner
                      and $entry.$ship.sector == $entry.$sector and $entry.$station.sector == $entry.$sector"/>
                </do_if>
                <set_value name="$parked" exact="player.station == $entry.$parking and not player.controlled and not player.occupiedship and @player.room.exists"/>
                <do_if value="$entry.$deal.buyer == $entry.$ship and $entry.$deal.seller == $entry.$station and $entry.$deal.ware == $entry.$ware">
                  <do_if value="$entry.$live">
                    <set_value name="State.$live_completed" exact="true"/>
                  </do_if>
                  <set_value name="$after_player_money" exact="(player.money / 1ct)L"/>
                  <set_value name="$after_faction_has_account" exact="faction.player.hasownaccount"/>
                  <set_value name="$after_faction_money" exact="if $after_faction_has_account then (faction.player.money / 1ct)L else 'unknown'"/>
                  <raise_lua_event name="'X4AuthorityCompanyStockTrade.Deal'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$entry.$request,$entry.$epoch,$entry.$trial,$entry.$quantity,($entry.$price / 1ct)L,$entry.$quote_time,player.age / 1s,$entry.$deal.buyer,$entry.$deal.seller,$entry.$deal.ware.id,$entry.$deal.transferredamount,$entry.$deal.destroyedamount,($entry.$deal.unitprice / 1ct)L,(($entry.$deal.unitprice * $entry.$deal.transferredamount) / 1ct)L,($entry.$before_player_money / 1ct)L,$after_player_money,if $entry.$before_faction_has_account then 1 else 0,if $after_faction_has_account then 1 else 0,$entry.$before_faction_money,$after_faction_money,$entry.$before_ship_cargo,$after_ship_cargo]"/>
                </do_if>
                <raise_lua_event name="'X4AuthorityCompanyStockTrade.Observed'" param="'%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$entry.$request,($entry.$price / 1ct)L,$delta_ship_cargo,$delta_station_cargo,$delta_ship_money,$delta_station_money,$delta_player_money,$docked,$parked]"/>
              </actions>
            </cue>
          </cues>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
