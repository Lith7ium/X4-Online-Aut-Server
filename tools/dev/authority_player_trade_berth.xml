<?xml version="1.0" encoding="utf-8"?>
<!-- One stock-assigned berth for the isolated WRN-302 trade UI fixture. -->
<mdscript name="X4AuthorityPlayerTradeBerth" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Prepare" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityPlayerTradeBerth'" control="'Prepare'"/></conditions>
   <actions>
    <set_value name="$Args" exact="event.param3"/>
    <set_value name="$Ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{7354}"/>
    <set_value name="$Station" exact="@md.X4AuthorityPlayerDockObserver.Cache.$Station"/>
    <set_value name="$Avatar" exact="player.entity"/>
    <include_actions ref="CheckBinding"/>
    <do_if value="$Status == 'READY'">
     <do_if value="@$Args.$ship != '%s'.[$Ship] or @$Args.$station != '%s'.[$Station]">
      <set_value name="$Status" exact="'BINDING_MISMATCH'"/>
     </do_if>
     <do_else>
      <!-- The cockpit already requested permission using the stock station action. -->
      <set_value name="$Deadline" exact="player.age + 25s"/>
      <set_value name="$Status" exact="'REQUESTED'"/>
     </do_else>
    </do_if>
    <include_actions ref="Reply"/>
   </actions>
   <cues>
    <!-- Retain stage state so observations do not depend on a completion event. -->
    <cue name="Assignment" checkinterval="0.5s">
     <conditions>
      <check_value value="@Prepare.$Status == 'REQUESTED'"/>
      <check_value value="player.age ge $Deadline or @$Ship.assigneddock.exists"/>
     </conditions>
     <actions>
      <set_value name="$Bay" exact="@$Ship.assigneddock"/>
      <include_actions ref="CheckAssignment"/>
      <do_if value="$Status == 'READY'">
       <set_value name="$Status" exact="'ASSIGNED'"/>
      </do_if>
      <include_actions ref="Reply"/>
     </actions>
     <cues>
      <cue name="Dispatch" checkinterval="0.5s">
       <conditions><check_value value="@Prepare.$Status == 'ASSIGNED'"/></conditions>
       <delay exact="0.5s"/>
       <actions>
        <include_actions ref="CheckAssignment"/>
        <do_if value="$Status == 'READY'">
         <dock ship="$Ship"/>
         <set_value name="$Status" exact="'DISPATCHED'"/>
        </do_if>
        <include_actions ref="Reply"/>
       </actions>
      </cue>
     </cues>
    </cue>
   </cues>
  </cue>

  <library name="CheckBinding" purpose="include_actions">
   <actions>
    <do_if value="@md.X4AuthorityShipRegistry.State.$epoch != '4ba7be438ebb04ec5bb85fdb95b5a488' or @md.X4AuthorityShipRegistry.State.$last != 10082 or not md.X4AuthorityShipRegistry.State.$faulted? or @md.X4AuthorityShipRegistry.State.$faulted">
     <set_value name="$Status" exact="'REGISTRY_INVALID'"/>
    </do_if>
    <do_elseif value="not @$Ship.isclass.ship or not $Ship.isoperational or $Ship.owner != faction.player or $Ship.idcode != 'WRN-302' or $Ship.macro.id != 'ship_arg_s_fighter_02_a_macro' or @$Ship.sector.macro.id != 'cluster_01_sector001_macro' or @md.X4AuthorityShipRegistry.State.$byship.{$Ship} != 7354 or @md.X4AuthorityShipRegistry.State.$ships.{7354} != $Ship">
     <set_value name="$Status" exact="'SHIP_INVALID'"/>
    </do_elseif>
    <do_elseif value="not @$Station.isclass.station or not $Station.isoperational or $Station.idcode != 'BIM-169' or $Station.owner != faction.teladi or $Station.trueowner != faction.teladi or $Station.macro.id != 'station_gen_factory_base_01_macro' or $Station.sector != $Ship.sector or @md.X4AuthorityPlayerDockObserver.Cache.$Station != $Station">
     <set_value name="$Status" exact="'STATION_INVALID'"/>
    </do_elseif>
    <do_elseif value="not @$Avatar.exists or player.entity != $Avatar or player.controlled != $Ship or player.occupiedship != $Ship or player.container != $Ship">
     <set_value name="$Status" exact="'PLAYER_CONTROL_INVALID'"/>
    </do_elseif>
    <do_elseif value="@$Ship.assignedaipilot.exists">
     <set_value name="$Status" exact="'CAPTAIN_PRESENT'"/>
    </do_elseif>
    <do_elseif value="$Ship.dock.exists or $Ship.isinternallystored">
     <set_value name="$Status" exact="'ALREADY_DOCKED_OR_STORED'"/>
    </do_elseif>
    <do_else>
     <set_value name="$Status" exact="'READY'"/>
    </do_else>
   </actions>
  </library>

  <library name="CheckAssignment" purpose="include_actions">
   <actions>
    <include_actions ref="CheckBinding"/>
    <do_if value="$Status == 'READY'">
     <do_if value="player.age ge $Deadline">
      <set_value name="$Status" exact="'ASSIGNMENT_TIMEOUT'"/>
     </do_if>
     <do_elseif value="not @$Bay.isclass.dockingbay or $Ship.assigneddock != $Bay or $Bay.assignedship != $Ship or $Bay.container != $Station or $Bay.isstorage or not $Bay.isdockingallowed or not $Bay.istradingallowed">
      <set_value name="$Status" exact="'ASSIGNMENT_MISMATCH'"/>
     </do_elseif>
    </do_if>
   </actions>
  </library>

  <library name="Reply" purpose="include_actions">
   <actions>
    <set_value name="$Receipt" exact="'%s|%s|%s|%s|%s|%s|%s|%s'.[$Status,if @$Ship.exists then $Ship else '0',if @$Station.exists then $Station else '0',if @$Bay.exists then $Bay else '0',if player.controlled then player.controlled else '0',if player.occupiedship then player.occupiedship else '0',if player.container then player.container else '0',player.age / 1s]"/>
    <debug_text text="'[X4LAN] AUTH_PLAYER_TRADE_BERTH %s'.[$Receipt]" chance="100"/>
    <raise_lua_event name="'X4AuthorityPlayerTradeBerth.Result'" param="$Receipt"/>
   </actions>
  </library>
 </cues>
</mdscript>
