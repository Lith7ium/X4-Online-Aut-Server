<?xml version="1.0" encoding="utf-8"?>
<mdscript name="X4AuthorityVanillaPairCreate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Prepare" namespace="this">
   <conditions><event_ui_triggered screen="'X4AuthorityVanillaPair'" control="'Create'"/></conditions>
   <actions>
    <set_value name="$nonce" exact="event.param3.$nonce"/>
    <set_value name="$count" exact="@event.param3.$count"/>
    <set_value name="$status" exact="if $count == 2 or $count == 4 then 'FRESH_WORLD' else 'COUNT'"/>
    <do_if value="($count == 2 or $count == 4) and player.module == 'custom_creative' and player.entity.exists and not player.isinconversation and not md.X4AuthorityShipRegistry.State.$epoch?">
     <find_sector name="$sectors" macro="macro.cluster_06_sector002_macro" multiple="true" required="false"/>
     <do_if value="$sectors.count == 1">
      <set_value name="$sector" exact="$sectors.{1}"/>
      <set_value name="$status" exact="'NO_FRIENDLY_DOCK'"/>
      <find_station name="$stations" space="$sector" functional="true" checkoperational="true" multiple="true" required="false">
       <match_relation_to faction="faction.player" relation="neutral" comparison="ge"/>
       <match_relation_of faction="faction.player" relation="neutral" comparison="ge"/>
      </find_station>
      <!-- Prefer the Argon trade station; fall back to any operational Argon station with a public dock. -->
      <do_for_each name="$candidate" in="$stations">
       <do_if value="$candidate.owner == faction.argon and $candidate.trueowner == faction.argon and (not @$station.exists or $candidate.macro == macro.station_arg_tradestation_base_01_macro)">
        <find_dockingbay name="$dock" object="$candidate" checkoperational="true" walkable="true" required="false">
         <match_dock walkable="true" storage="false"/>
        </find_dockingbay>
        <do_if value="@$dock.exists and (not @player.ship.isclass.ship or $candidate.dockingallowed.{player.ship})">
         <set_value name="$station" exact="$candidate"/>
         <do_if value="$station.macro == macro.station_arg_tradestation_base_01_macro"><break/></do_if>
        </do_if>
       </do_if>
      </do_for_each>
      <do_if value="@$station.exists">
       <set_value name="$status" exact="'LOADOUT'"/>
       <get_loadout loadout="'x4lan_company_pulsar'" macro="macro.ship_arg_s_fighter_03_a_macro" result="$loadout"/>
       <do_if value="$loadout">
        <set_value name="$status" exact="'CREATE'"/>
        <set_value name="$ships" exact="[]"/>
        <do_all exact="$count" counter="$i">
         <create_ship name="$ship" macro="macro.ship_arg_s_fighter_03_a_macro" sector="$sector" seed="7380 + $i">
          <owner exact="faction.player" overridenpc="true"/>
          <loadout loadout="$loadout"/>
          <position x="if $i le 2 then 20km else 23km" y="100km" z="if $i == 1 or $i == 3 then -1500m else 1500m"/>
          <rotation yaw="if $i == 1 or $i == 3 then 0deg else 180deg" pitch="0deg" roll="0deg"/>
         </create_ship>
         <do_if value="not @$ship.isoperational or $ship.sector != $sector or $ship.owner != faction.player or $ship.pilot.exists or $ship.assignedpilot.exists"><break/></do_if>
         <append_to_list name="$ships" exact="$ship"/>
        </do_all>
        <do_if value="$ships.count == $count and $ships.{1} != $ships.{2}">
         <set_value name="$status" exact="'CREATED'"/>
         <do_if value="@event.param3.$boarding_transport == true">
          <set_value name="$status" exact="'BOARDING_TRANSPORT_REFUSED'"/>
          <set_value name="$anchor" exact="$ships.{1}"/>
          <create_ship name="$transport" macro="macro.ship_arg_m_trans_container_01_a_macro" sector="$sector" seed="8627">
           <owner exact="faction.player" overridenpc="true"/>
           <loadout><level exact="1.0"/><variation exact="0"/></loadout>
           <pilot><select race="race.argon" tags="tag.aipilot"/></pilot>
           <safepos object="$anchor" x="18km" y="2km" z="4km"/>
          </create_ship>
          <do_if value="@$transport.isoperational and $transport.isclass.ship_m
                        and $transport.macro == macro.ship_arg_m_trans_container_01_a_macro
                        and $transport.sector == $sector and $transport.owner == faction.player
                        and $transport.trueowner == faction.player and @$transport.pilot.isclass.npc
                        and $transport.pilot != player.entity and $transport.pilot.owner == faction.player
                        and $transport.assignedaipilot == $transport.pilot">
           <set_value name="$status" exact="'BOARDING_CREW_REFUSED'"/>
           <do_all exact="8">
            <create_npc_template object="$transport" macro="macro.character_argon_female_pilot_01_macro" role="entityrole.marine"/>
           </do_all>
           <set_value name="$marines" exact="0"/>
           <do_for_each name="$person" in="$transport.people.list">
            <do_if value="$transport.people.{$person}.role == entityrole.marine">
             <set_value name="$marines" exact="1" operation="add"/>
            </do_if>
           </do_for_each>
           <set_value name="$distance" exact="$transport.distanceto.{$anchor} / 1m"/>
           <do_if value="$marines == 8 and $transport.people.count == 8 and $distance ge 12000 and $distance le 30000 and $transport.idcode">
            <set_value name="$status" exact="'CREATED'"/>
            <debug_text text="'[X4LAN] AUTH_VANILLA_BOARDING %s|%s|%s|%s'.[$nonce,$transport.idcode,$sector.macro.id,$marines]" chance="100"/>
           </do_if>
          </do_if>
         </do_if>
         <do_if value="$status == 'CREATED'">
          <teleport_player object="$station" control="false" instant="true" force="true"/>
         </do_if>
        </do_if>
       </do_if>
      </do_if>
     </do_if>
    </do_if>
    <raise_lua_event name="'X4AuthorityVanillaPair.Created'" param="'%s|%s'.[$nonce,$status]"/>
   </actions>
  </cue>
 </cues>
</mdscript>
