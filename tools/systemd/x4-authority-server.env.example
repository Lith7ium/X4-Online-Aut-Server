# Copy to ~/.config/x4-authority/server.env (mode 600) and adjust the paths.
# The game path may contain spaces. X4_LAUNCHER_OPTIONS is split at whitespace.
X4_GAME=/home/operator/.local/share/Steam/steamapps/common/X4 Foundations
X4_INITIAL_STORE=/home/operator/x4-authority-test-server/.local/source-run/checkpoints
X4_RUNS=/home/operator/x4-authority-test-server/.local/dedicated
# Launcher options, then -- and the provider options for this world.
X4_LAUNCHER_OPTIONS=--empty-checkpoint-seconds 900 -- --base-game-only --require-registry-snapshot
