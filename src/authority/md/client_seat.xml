<?xml version="1.0" encoding="utf-8"?>
<mdscript name="X4AuthorityClientSeat" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="Seat" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityClientSeat'" control="'Seat'"/>
   </conditions>
   <actions>
    <set_value name="$args" exact="event.param3"/>
    <set_value name="$index" exact="$args.$index"/>
    <set_value name="$action" exact="$args.$action"/>
    <set_value name="$result" exact="'REGISTRY_INVALID'"/>
    <set_value name="$actor" exact="'0'"/>
    <set_value name="$owner" exact="'0'"/>
    <set_value name="$captainid" exact="'0'"/>
    <do_if value="md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$faulted? and md.X4AuthorityShipRegistry.State.$ships? and md.X4AuthorityShipRegistry.State.$byship? and not md.X4AuthorityShipRegistry.State.$faulted">
     <set_value name="$live" exact="$action == 'relief' or $action == 'helm' or $action == 'helmsample'"/>
     <do_if value="md.X4AuthorityShipRegistry.State.$epoch != $args.$epoch
                   or md.X4AuthorityShipRegistry.State.$last lt $args.$count
                   or (not $live and md.X4AuthorityShipRegistry.State.$last != $args.$count)">
      <set_value name="$result" exact="'REGISTRY_CHANGED'"/>
     </do_if>
     <do_elseif value="$index lt 1 or $index gt md.X4AuthorityShipRegistry.State.$last or $index != ($index)i">
      <set_value name="$result" exact="'INDEX_INVALID'"/>
     </do_elseif>
     <do_else>
      <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$index}"/>
      <do_if value="not @$ship.isclass.ship or @md.X4AuthorityShipRegistry.State.$byship.{$ship} != $index">
       <set_value name="$result" exact="'BINDING_INVALID'"/>
      </do_if>
      <do_elseif value="$ship.owner != faction.player">
       <set_value name="$result" exact="'OWNER_INVALID'"/>
      </do_elseif>
      <do_elseif value="not $ship.isoperational">
       <set_value name="$result" exact="'SHIP_INOPERABLE'"/>
      </do_elseif>
      <do_else>
       <set_value name="$actor" exact="'%s'.[$ship]"/>
       <set_value name="$owner" exact="$ship.owner.id"/>
       <do_if value="$action != 'inspect' and $args.$actor != $actor">
        <set_value name="$result" exact="'TARGET_CHANGED'"/>
       </do_if>
       <do_elseif value="(@$args.$captain and $args.$captain != '0')
                             or ($action == 'inspect' and (@$ship.pilot.exists or @$ship.assignedpilot.exists)
                                 and player.controlled != $ship)">
        <include_actions ref="CrewSeat"/>
       </do_elseif>
       <do_elseif value="player.ship == $ship and player.occupiedship == $ship and player.controlled == $ship and player.container == $ship">
        <set_value name="$result" exact="'CONTROLLED'"/>
       </do_elseif>
       <do_elseif value="$action == 'verify'">
        <set_value name="$result" exact="'CONTROL_MISSING'"/>
       </do_elseif>
       <do_elseif value="$ship == player.ship or $ship == player.occupiedship or $ship == player.controlled or $ship == player.container">
        <set_value name="$result" exact="'PLAYER_CONTEXT'"/>
       </do_elseif>
       <do_elseif value="$ship.dock.exists or $ship.isinternallystored">
        <set_value name="$result" exact="'SHIP_DOCKED_OR_STORED'"/>
       </do_elseif>
       <do_elseif value="not @$ship.sector.isclass.sector">
        <set_value name="$result" exact="'SHIP_SECTOR_INVALID'"/>
       </do_elseif>
       <do_elseif value="$ship.pilot.exists or $ship.assignedpilot.exists">
        <set_value name="$result" exact="'PILOT_PRESENT'"/>
       </do_elseif>
       <do_elseif value="$action == 'inspect'">
        <set_value name="$result" exact="'READY'"/>
       </do_elseif>
       <do_elseif value="$action == 'take'">
        <teleport_player object="$ship" control="true" instant="true" force="true"/>
        <set_value name="$result" exact="'DISPATCHED'"/>
       </do_elseif>
       <do_else>
        <set_value name="$result" exact="'ACTION_INVALID'"/>
       </do_else>
      </do_else>
     </do_else>
    </do_if>
    <raise_lua_event name="'X4AuthorityClientSeat.Result'" param="'%s|%s|%s|%s|%s|%s|%s|%s'.[$args.$nonce,$args.$epoch,$index,$action,$result,$actor,$owner,$captainid]"/>
   </actions>
  </cue>
  <cue name="OccupiedBerth" instantiate="true" namespace="this">
   <conditions>
    <event_ui_triggered screen="'X4AuthorityClientSeat'" control="'ReadOccupiedBerth'"/>
   </conditions>
   <actions>
    <set_value name="$args" exact="event.param3"/>
    <set_value name="$receipt" exact="'UNAVAILABLE'"/>
    <do_if value="@md.X4AuthorityShipRegistry.State.$epoch == @$args.$epoch
        and @md.X4AuthorityShipRegistry.State.$last == @$args.$count
        and @md.X4AuthorityShipRegistry.State.$faulted == false
        and @$args.$index ge 1 and $args.$index le md.X4AuthorityShipRegistry.State.$last
        and ($args.$index)i == $args.$index">
     <set_value name="$ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$args.$index}"/>
     <do_if value="@$ship.isclass.ship and $ship.isoperational and $ship.owner == faction.player
         and $ship.trueowner == faction.player and @md.X4AuthorityShipRegistry.State.$byship.{$ship} == $args.$index
         and '%s'.[$ship] == @$args.$actor and $ship == player.controlled
         and $ship == player.occupiedship and $ship == player.container and not $ship.isinternallystored">
      <set_value name="$bay" exact="@$ship.dock"/>
      <set_value name="$station" exact="@$bay.container"/>
      <do_if value="@$bay.isclass.dockingbay and $bay.external and not $bay.isstorage
          and $bay.dockstate == dockstate.default and $bay.istradingallowed
          and @$bay.dockarea.isclass.dockarea and $bay.docked.count == 1 and $bay.docked.{1} == $ship
          and @$station.isclass.station and $station.isoperational and @$station.sector.isclass.sector
          and $ship.sector == $station.sector">
       <set_value name="$receipt" exact="'%s|%s|%s|%s|%s'.[$station.sector.macro.id,$station.idcode,$bay.seed,$bay.macro.id,$bay.dockarea.macro.id]"/>
      </do_if>
     </do_if>
    </do_if>
    <raise_lua_event name="'X4AuthorityClientSeat.OccupiedBerth'" param="'%s|%s|%s|%s|%s|%s'.[$args.$nonce,$args.$epoch,$args.$index,$args.$request,$args.$actor,$receipt]"/>
   </actions>
  </cue>
  <library name="CrewSeat" purpose="include_actions">
   <actions>
    <set_value name="$captain" exact="@$ship.assignedaipilot"/>
    <set_value name="$result" exact="'CAPTAIN_CHANGED'"/>
    <do_if value="@$captain.isclass.npc and $captain.owner == faction.player
                  and $captain.assignedcontrolled == $ship and $ship.trueowner == faction.player
                  and ($action == 'inspect' or '%s'.[$captain] == @$args.$captain)">
     <set_value name="$captainid" exact="'%s'.[$captain]"/>
     <set_value name="$result" exact="'SHIP_DOCKED_OR_STORED'"/>
     <set_value name="$dock" exact="@$ship.dock"/>
     <set_value name="$station" exact="@$dock.container"/>
     <do_if value="not $ship.isinternallystored and @$ship.sector.isclass.sector
                   and ((not $dock and not @$ship.assigneddock)
                        or (@$dock.isclass.dockingbay and $dock.external and not $dock.isstorage
                            and $dock.dockstate == dockstate.default and $dock.istradingallowed
                            and $dock.docked.count == 1 and $dock.docked.{1} == $ship
                            and @$station.isclass.station and $station.isoperational
                            and $station.sector == $ship.sector))">
      <include_actions ref="CrewAction"/>
     </do_if>
    </do_if>
   </actions>
  </library>

  <library name="CrewAction" purpose="include_actions">
   <actions>
    <set_value name="$playeraboard" exact="player.container == $ship and @player.room.exists and not player.controlled"/>
    <set_value name="$captainaboard" exact="@$captain.ship == $ship and @$captain.hascontext.{$ship}"/>
    <set_value name="$result" exact="'CAPTAIN_CONTEXT'"/>
    <do_if value="$action == 'inspect' or $action == 'board'">
     <do_if value="$ship.pilot == $captain and not player.controlled and not player.occupiedship
                   and player.container != $ship and player.ship != $ship">
      <set_value name="$result" exact="'CREWED'"/>
      <do_if value="$action == 'board'">
       <teleport_player object="$ship" control="false" instant="true" force="true"/>
       <set_value name="$result" exact="'BOARD_DISPATCHED'"/>
      </do_if>
     </do_if>
    </do_if>
    <do_elseif value="$action == 'aboard'">
     <do_if value="$playeraboard and $captainaboard and $ship.pilot == $captain">
      <set_value name="$result" exact="'ABOARD'"/>
     </do_if>
     <do_elseif value="not player.controlled and (player.container == $ship or not player.occupiedship)">
      <set_value name="$result" exact="'BOARD_WAIT'"/>
     </do_elseif>
    </do_elseif>
    <do_elseif value="$captainaboard">
     <include_actions ref="CrewHelm"/>
    </do_elseif>
   </actions>
  </library>

  <library name="CrewHelm" purpose="include_actions">
   <actions>
    <find_npc_slot name="$chair" object="$ship" post="controlpost.aipilot" excludefilled="false"/>
    <set_value name="$chairoccupant" exact="@$chair.component.slotactor.{$chair}"/>
    <do_if value="$action == 'helmsample' and $chairoccupant == player.entity
                  and player.controlled == $ship and player.occupiedship == $ship
                  and player.container == $ship and player.ship == $ship">
     <set_value name="$result" exact="'CONTROLLED'"/>
    </do_if>
    <do_elseif value="$action == 'helmsample' and player.container == $ship
                      and (not player.controlled or player.controlled == $ship)">
     <set_value name="$result" exact="'HELM_WAIT'"/>
    </do_elseif>
    <do_elseif value="$playeraboard and $chair and $action == 'relief'
                      and (not $chairoccupant or $chairoccupant == $captain)">
     <set_value name="$result" exact="'RELIEF_WAIT'"/>
     <!-- Match the stock Get up conversation guard. Keep every ship order intact. -->
     <do_if value="$chairoccupant == $captain and $ship.pilot == $captain
                   and (not $ship.order or $ship.order.canplayercancel)">
      <signal_objects object="$captain" param="'npc__leave_post'"/>
      <set_value name="$result" exact="'RELIEF_DISPATCHED'"/>
     </do_if>
    </do_elseif>
    <do_elseif value="$playeraboard and $chair and $action == 'helm'
                      and (not $chairoccupant or $chairoccupant == $captain)">
     <set_value name="$result" exact="'HELM_WAIT'"/>
     <do_if value="not $chairoccupant and $captain.isbusy">
      <teleport_player object="$ship" control="true" instant="true" force="true"/>
      <set_value name="$result" exact="'HELM_DISPATCHED'"/>
     </do_if>
    </do_elseif>
   </actions>
  </library>
 </cues>
</mdscript>
