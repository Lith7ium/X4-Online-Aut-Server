<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable opt-in READ-ONLY combat observation MD script for authority investigation.
     Default-off / inert until explicitly armed via X4AuthorityCombatObserver/Arm.
     Strictly read-only: NEVER writes hull, shield, min-hull, damage, weapon, or destruction state.
     Reuses proven LAN diagnostic patterns: per-instance cue namespaces (Host01), synchronous
     lastattacker/lastattacktime readback inside damage callbacks (LAST-ATTACKER-NATIVE), and
     same-age collision-pair recording (damage-dedup-06). -->
<mdscript name="X4AuthorityCombatObserver" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
 <cues>
  <cue name="State">
   <actions>
    <set_value name="State.$armed" exact="false"/>
    <set_value name="State.$epoch" exact="''"/>
    <set_value name="State.$seq" exact="0"/>
    <set_value name="State.$watch_player_ship" exact="false"/>
    <set_value name="State.$watch_player_owned" exact="false"/>
    <set_value name="State.$labels" exact="table[]"/>
    <set_value name="State.$weapon_counts" exact="table[]"/>
    <set_value name="State.$collisions" exact="[]"/>
    <set_value name="State.$collision_age" exact="-1s"/>
    <create_group groupname="State.$targets"/>
    <create_group groupname="State.$sources"/>
    <create_group groupname="State.$weapons"/>
   </actions>
   <cues>
    <library name="ReadRegistryState" purpose="include_actions">
     <actions>
      <set_value name="$reg_ready" exact="State.$epoch != ''
          and md.X4AuthorityShipRegistry.State.$epoch? and md.X4AuthorityShipRegistry.State.$epoch == State.$epoch
          and md.X4AuthorityShipRegistry.State.$faulted? and not md.X4AuthorityShipRegistry.State.$faulted
          and md.X4AuthorityShipRegistry.State.$last? and md.X4AuthorityShipRegistry.State.$ships?
          and md.X4AuthorityShipRegistry.State.$byship?"/>
     </actions>
    </library>

    <!-- Read either direction, then require the same live ship and index in both tables. -->
    <library name="ResolveRegistryBinding" purpose="include_actions">
     <actions>
      <set_value name="$registered_ship" exact="null"/>
      <set_value name="$registered_index" exact="0"/>
      <do_if value="$reg_ready">
       <set_value name="$candidate_index" exact="$lookup_index"/>
       <do_if value="not $lookup_by_index and @$lookup_ship.isclass.ship">
        <set_value name="$candidate_index" exact="@md.X4AuthorityShipRegistry.State.$byship.{$lookup_ship}"/>
       </do_if>
       <do_if value="(typeof $candidate_index).isnumeric and $candidate_index ge 1
                     and $candidate_index le md.X4AuthorityShipRegistry.State.$last
                     and $candidate_index == ($candidate_index)i">
        <set_value name="$candidate_ship" exact="@md.X4AuthorityShipRegistry.State.$ships.{$candidate_index}"/>
        <do_if value="@$candidate_ship.exists and $candidate_ship.isclass.ship
                      and ($lookup_ship == null or $candidate_ship == $lookup_ship)
                      and @md.X4AuthorityShipRegistry.State.$byship.{$candidate_ship} == $candidate_index">
         <set_value name="$registered_ship" exact="$candidate_ship"/>
         <set_value name="$registered_index" exact="$candidate_index"/>
        </do_if>
       </do_if>
      </do_if>
     </actions>
    </library>

    <!-- Shared read-only serializer: reads native attacker, registry index, shield/hull, and
         same-age collision flags synchronously inside each callback without modifying game state. -->
    <library name="Emit">
     <actions>
      <set_value name="State.$seq" operation="add" exact="1"/>
      <set_value name="$seq" exact="State.$seq"/>
      <set_value name="$age_s" exact="player.age / 1s"/>

      <include_actions ref="ReadRegistryState"/>
      <set_value name="$lookup_by_index" exact="false"/>
      <set_value name="$lookup_index" exact="null"/>

      <!-- Victim fields -->
      <set_value name="$v_str" exact="'0'"/>
      <set_value name="$v_label" exact="'none'"/>
      <set_value name="$v_code" exact="'none'"/>
      <set_value name="$v_owner" exact="'none'"/>
      <set_value name="$v_reg" exact="0"/>
      <set_value name="$v_ctrl" exact="0"/>
      <set_value name="$v_occ" exact="0"/>
      <set_value name="$shield" exact="-1"/>
      <set_value name="$maxshield" exact="-1"/>
      <set_value name="$shieldpct" exact="-1"/>
      <set_value name="$hull" exact="-1"/>
      <set_value name="$maxhull" exact="-1"/>
      <set_value name="$hullpct" exact="-1"/>
      <set_value name="$last_att" exact="null"/>
      <set_value name="$last_att_time" exact="-1"/>
      <do_if value="@$victim.exists">
       <set_value name="$v_str" exact="'%s'.[$victim]"/>
       <do_if value="State.$labels.{$victim}?"><set_value name="$v_label" exact="State.$labels.{$victim}"/></do_if>
       <do_if value="@$victim.idcode"><set_value name="$v_code" exact="$victim.idcode"/></do_if>
       <do_if value="@$victim.owner.id"><set_value name="$v_owner" exact="$victim.owner.id"/></do_if>
       <set_value name="$lookup_ship" exact="$victim"/>
       <include_actions ref="ResolveRegistryBinding"/>
       <set_value name="$v_reg" exact="$registered_index"/>
       <do_if value="@player.controlled == $victim"><set_value name="$v_ctrl" exact="1"/></do_if>
       <do_if value="@player.occupiedship == $victim"><set_value name="$v_occ" exact="1"/></do_if>
       <set_value name="$shield" exact="@$victim.shield"/>
       <set_value name="$maxshield" exact="@$victim.maxshield"/>
       <set_value name="$shieldpct" exact="@$victim.shieldpercentage"/>
       <set_value name="$hull" exact="@$victim.hull"/>
       <set_value name="$maxhull" exact="@$victim.maxhull"/>
       <set_value name="$hullpct" exact="@$victim.hullpercentage"/>
       <set_value name="$last_att" exact="@$victim.lastattacker"/>
       <do_if value="@$victim.lastattacktime gt 0s">
        <set_value name="$last_att_time" exact="$victim.lastattacktime / 1s"/>
       </do_if>
      </do_if>

      <!-- Event-supplied attacker fields -->
      <set_value name="$ea_str" exact="'0'"/>
      <set_value name="$ea_label" exact="'none'"/>
      <set_value name="$ea_code" exact="'none'"/>
      <set_value name="$ea_owner" exact="'none'"/>
      <set_value name="$ea_reg" exact="0"/>
      <set_value name="$ea_ctrl" exact="0"/>
      <set_value name="$ea_isship" exact="0"/>
      <set_value name="$ea_pilot" exact="'0'"/>
      <do_if value="@$ev_att.exists">
       <set_value name="$ea_str" exact="'%s'.[$ev_att]"/>
       <do_if value="State.$labels.{$ev_att}?"><set_value name="$ea_label" exact="State.$labels.{$ev_att}"/></do_if>
       <do_if value="@$ev_att.idcode"><set_value name="$ea_code" exact="$ev_att.idcode"/></do_if>
       <do_if value="@$ev_att.owner.id"><set_value name="$ea_owner" exact="$ev_att.owner.id"/></do_if>
       <set_value name="$lookup_ship" exact="$ev_att"/>
       <include_actions ref="ResolveRegistryBinding"/>
       <set_value name="$ea_reg" exact="$registered_index"/>
       <do_if value="@player.controlled == $ev_att"><set_value name="$ea_ctrl" exact="1"/></do_if>
       <do_if value="@$ev_att.isclass.ship"><set_value name="$ea_isship" exact="1"/></do_if>
       <do_if value="@$ev_att.pilot.exists"><set_value name="$ea_pilot" exact="'%s'.[$ev_att.pilot]"/></do_if>
      </do_if>

      <!-- Victim lastattacker getter fields -->
      <set_value name="$la_str" exact="'0'"/>
      <set_value name="$la_label" exact="'none'"/>
      <set_value name="$la_code" exact="'none'"/>
      <set_value name="$la_owner" exact="'none'"/>
      <set_value name="$la_reg" exact="0"/>
      <set_value name="$la_ctrl" exact="0"/>
      <set_value name="$la_isship" exact="0"/>
      <do_if value="@$last_att.exists">
       <set_value name="$la_str" exact="'%s'.[$last_att]"/>
       <do_if value="State.$labels.{$last_att}?"><set_value name="$la_label" exact="State.$labels.{$last_att}"/></do_if>
       <do_if value="@$last_att.idcode"><set_value name="$la_code" exact="$last_att.idcode"/></do_if>
       <do_if value="@$last_att.owner.id"><set_value name="$la_owner" exact="$last_att.owner.id"/></do_if>
       <set_value name="$lookup_ship" exact="$last_att"/>
       <include_actions ref="ResolveRegistryBinding"/>
       <set_value name="$la_reg" exact="$registered_index"/>
       <do_if value="@player.controlled == $last_att"><set_value name="$la_ctrl" exact="1"/></do_if>
       <do_if value="@$last_att.isclass.ship"><set_value name="$la_isship" exact="1"/></do_if>
      </do_if>

      <!-- Damaged component / subcomponent fields -->
      <set_value name="$c_str" exact="'0'"/>
      <set_value name="$is_root" exact="0"/>
      <set_value name="$c_macro" exact="'none'"/>
      <do_if value="@$comp.exists">
       <set_value name="$c_str" exact="'%s'.[$comp]"/>
       <do_if value="@$victim.exists and $comp == $victim"><set_value name="$is_root" exact="1"/></do_if>
       <do_if value="@$comp.macro.id"><set_value name="$c_macro" exact="$comp.macro.id"/></do_if>
      </do_if>

      <!-- Same-age collision check against both event attacker and lastattacker -->
      <set_value name="$collided" exact="0"/>
      <do_if value="State.$collision_age == player.age and @$victim.exists">
       <do_all exact="State.$collisions.count" counter="$ci">
        <do_if value="State.$collisions.{$ci}.{1} == $victim and ((@$last_att.exists and State.$collisions.{$ci}.{2} == $last_att) or (@$ev_att.exists and State.$collisions.{$ci}.{2} == $ev_att))">
         <set_value name="$collided" exact="1"/>
        </do_if>
       </do_all>
      </do_if>

      <set_value name="$payload" exact="'%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s'.[$seq,$kind,$age_s,$v_str,$v_label,$v_code,$v_owner,$v_reg,$v_ctrl,$v_occ,$ea_str,$ea_label,$ea_code,$ea_owner,$ea_reg,$ea_ctrl,$ea_isship,$ea_pilot,$la_str,$la_label,$la_code,$la_owner,$la_reg,$la_ctrl,$la_isship,$last_att_time,$c_str,$is_root,$c_macro,$p2_str,$p3_str,$amount,$shield,$maxshield,$shieldpct,$hull,$maxhull,$hullpct,$collided]"/>
      <debug_text text="'[X4LAN] AUTH_COMBAT_OBS ' + $payload"/>
      <raise_lua_event name="'X4AuthorityCombatObserver.Event'" param="$payload"/>
     </actions>
    </library>

    <!-- Control: Arm read-only observation (clears previous watch state). -->
    <cue name="Arm" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatObserver'" control="'Arm'"/></conditions>
     <actions>
      <set_value name="$a" exact="event.param3"/>
      <set_value name="State.$armed" exact="false"/>
      <clear_group group="State.$targets"/>
      <clear_group group="State.$sources"/>
      <clear_group group="State.$weapons"/>
      <set_value name="State.$labels" exact="table[]"/>
      <set_value name="State.$weapon_counts" exact="table[]"/>
      <set_value name="State.$collisions" exact="[]"/>
      <set_value name="State.$collision_age" exact="-1s"/>
      <set_value name="State.$seq" exact="0"/>
      <set_value name="State.$epoch" exact="if $a.$epoch? then $a.$epoch else ''"/>
      <set_value name="State.$watch_player_ship" exact="@$a.$watch_player_ship == true"/>
      <set_value name="State.$watch_player_owned" exact="@$a.$watch_player_owned == true"/>
      <set_value name="State.$armed" exact="true"/>
      <debug_text text="'[X4LAN] AUTH_COMBAT_OBS_CTRL action=Arm epoch=%s player_ship=%s player_owned=%s'.[State.$epoch,State.$watch_player_ship,State.$watch_player_owned]"/>
      <raise_lua_event name="'X4AuthorityCombatObserver.Status'" param="'%s|Armed|%s'.[@$a.$request_id,State.$epoch]"/>
     </actions>
    </cue>

    <!-- Control: Add one ship to target/source/weapon watch groups (by direct ship ref or registry_index). -->
    <cue name="Watch" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatObserver'" control="'Watch'"/></conditions>
     <actions>
      <set_value name="$a" exact="event.param3"/>
      <set_value name="$ship" exact="@$a.$ship"/>
      <do_if value="State.$armed">
       <include_actions ref="ReadRegistryState"/>
       <set_value name="$lookup_ship" exact="$ship"/>
       <set_value name="$lookup_by_index" exact="$a.$registry_index?"/>
       <set_value name="$lookup_index" exact="@$a.$registry_index"/>
       <include_actions ref="ResolveRegistryBinding"/>
       <do_if value="$lookup_by_index">
        <set_value name="$ship" exact="$registered_ship"/>
       </do_if>
      </do_if>
      <set_value name="$label" exact="if $a.$label? then $a.$label else 'unnamed'"/>
      <do_if value="State.$armed and @$ship.exists and $ship.isclass.ship">
       <set_value name="State.$labels.{$ship}" exact="$label"/>
       <do_if value="@$a.$as_target == true">
        <add_to_group groupname="State.$targets" object="$ship"/>
       </do_if>
       <do_if value="@$a.$as_source == true">
        <add_to_group groupname="State.$sources" object="$ship"/>
       </do_if>
       <set_value name="$wcount" exact="0"/>
       <do_if value="@$a.$watch_weapons == true and $ship.isoperational">
        <set_value name="$wlist" exact="$ship.weapons.operational.list"/>
        <set_value name="$wcount" exact="$wlist.count"/>
        <do_if value="$wcount gt 0">
         <add_to_group groupname="State.$weapons" list="$wlist"/>
        </do_if>
       </do_if>
       <set_value name="$reg_idx" exact="$registered_index"/>
       <debug_text text="'[X4LAN] AUTH_COMBAT_OBS_CTRL action=Watch label=%s ship=%s code=%s owner=%s reg=%s target=%s source=%s weapons=%s hull=%s/%s shield=%s/%s'.[$label,$ship,@$ship.idcode,@$ship.owner.id,$reg_idx,@$a.$as_target == true,@$a.$as_source == true,$wcount,@$ship.hull,@$ship.maxhull,@$ship.shield,@$ship.maxshield]"/>
       <raise_lua_event name="'X4AuthorityCombatObserver.Status'" param="'%s|Watched|%s|%s|%s|%s|%s|%s'.[@$a.$request_id,$label,$ship,@$ship.idcode,@$ship.owner.id,$reg_idx,$wcount]"/>
      </do_if>
      <do_else>
       <raise_lua_event name="'X4AuthorityCombatObserver.Status'" param="'%s|WatchRefused|%s'.[@$a.$request_id,$label]"/>
      </do_else>
     </actions>
    </cue>

    <!-- Control: Emit an on-demand read-only snapshot for a watched ship (or all watched targets). -->
    <cue name="Snapshot" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatObserver'" control="'Snapshot'"/></conditions>
     <actions>
      <set_value name="$a" exact="event.param3"/>
      <do_if value="State.$armed">
       <set_value name="$tag" exact="if $a.$tag? then $a.$tag else 'snap'"/>
       <do_if value="@$a.$ship.exists">
        <set_value name="$kind" exact="'snapshot'"/>
        <set_value name="$victim" exact="$a.$ship"/>
        <set_value name="$ev_att" exact="null"/>
        <set_value name="$comp" exact="$a.$ship"/>
        <set_value name="$p2_str" exact="$tag"/>
        <set_value name="$p3_str" exact="'%s'.[@$a.$ship.isoperational]"/>
        <set_value name="$amount" exact="0"/>
        <include_actions ref="Emit"/>
       </do_if>
       <do_else>
        <do_all exact="State.$targets.count" counter="$ti">
         <set_value name="$kind" exact="'snapshot'"/>
         <set_value name="$victim" exact="State.$targets.{$ti}"/>
         <set_value name="$ev_att" exact="null"/>
         <set_value name="$comp" exact="$victim"/>
         <set_value name="$p2_str" exact="$tag"/>
         <set_value name="$p3_str" exact="'%s'.[@$victim.isoperational]"/>
         <set_value name="$amount" exact="0"/>
         <include_actions ref="Emit"/>
        </do_all>
       </do_else>
       <raise_lua_event name="'X4AuthorityCombatObserver.Status'" param="'%s|SnapshotDone|%s|%s'.[@$a.$request_id,$tag,State.$seq]"/>
      </do_if>
     </actions>
    </cue>

    <!-- Control: Disarm read-only observation. -->
    <cue name="Disarm" instantiate="true" namespace="this">
     <conditions><event_ui_triggered screen="'X4AuthorityCombatObserver'" control="'Disarm'"/></conditions>
     <actions>
      <set_value name="$a" exact="event.param3"/>
      <set_value name="State.$armed" exact="false"/>
      <clear_group group="State.$targets"/>
      <clear_group group="State.$sources"/>
      <clear_group group="State.$weapons"/>
      <debug_text text="'[X4LAN] AUTH_COMBAT_OBS_CTRL action=Disarm seq=%s'.[State.$seq]"/>
      <raise_lua_event name="'X4AuthorityCombatObserver.Status'" param="'%s|Disarmed|%s'.[@$a.$request_id,State.$seq]"/>
     </actions>
    </cue>

    <!-- Event 1: Same-frame collision tracking (reused from LAN damage-dedup-06). -->
    <cue name="ObjectCollided" instantiate="true" namespace="this">
     <conditions>
      <event_object_collided group="State.$targets"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <do_if value="State.$collision_age != player.age">
       <set_value name="State.$collisions" exact="[]"/>
       <set_value name="State.$collision_age" exact="player.age"/>
      </do_if>
      <append_to_list name="State.$collisions" exact="[event.object, event.param]"/>
      <append_to_list name="State.$collisions" exact="[event.param, event.object]"/>
      <set_value name="$kind" exact="'collided'"/>
      <set_value name="$victim" exact="event.object"/>
      <set_value name="$ev_att" exact="@event.param"/>
      <set_value name="$comp" exact="event.object"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 2: Per-hit shield damage callback (fires even when shields absorb 100%). -->
    <cue name="ShieldDamaged" instantiate="true" namespace="this">
     <conditions>
      <event_object_shield_damaged group="State.$targets"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'shield_damaged'"/>
      <set_value name="$victim" exact="event.object"/>
      <set_value name="$ev_att" exact="null"/>
      <set_value name="$comp" exact="@event.param"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="if event.param3? then event.param3 else 0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 3: Per-hit hull damage callback (fires when damage reaches hull/surface element). -->
    <cue name="HullDamaged" instantiate="true" namespace="this">
     <conditions>
      <event_object_hull_damaged group="State.$targets"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'hull_damaged'"/>
      <set_value name="$victim" exact="event.object"/>
      <set_value name="$ev_att" exact="null"/>
      <set_value name="$comp" exact="@event.param"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="if event.param3? then event.param3 else 0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 4: Throttled victim-side attack notification (~1/s per attacker+method). -->
    <cue name="ObjectAttacked" instantiate="true" namespace="this">
     <conditions>
      <event_object_attacked group="State.$targets"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'object_attacked'"/>
      <set_value name="$victim" exact="event.object"/>
      <set_value name="$ev_att" exact="@event.param"/>
      <set_value name="$comp" exact="event.object"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 5: Throttled attacker-side attack notification for watched source ships. -->
    <cue name="ObjectAttackedObject" instantiate="true" namespace="this">
     <conditions>
      <event_object_attacked_object group="State.$sources"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'object_attacked_object'"/>
      <set_value name="$ev_att" exact="event.object"/>
      <set_value name="$victim" exact="@event.param"/>
      <set_value name="$comp" exact="@event.param"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 6: Player-owned victim notification (filtered to watched targets). -->
    <cue name="PlayerOwnedAttacked" instantiate="true" namespace="this">
     <conditions>
      <event_player_owned_attacked/>
      <check_value value="State.$armed and State.$watch_player_owned and State.$targets.indexof.{event.object} gt 0"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'player_owned_attacked'"/>
      <set_value name="$victim" exact="event.object"/>
      <set_value name="$ev_att" exact="@event.param"/>
      <set_value name="$comp" exact="event.object"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 7: Player-owned attacker notification (global event: param=attacker, param2=victim, param3=killmethod). -->
    <cue name="PlayerOwnedAttackedObject" instantiate="true" namespace="this">
     <conditions>
      <event_player_owned_attacked_object/>
      <check_value value="State.$armed and State.$watch_player_owned and (State.$sources.indexof.{@event.param} gt 0 or State.$targets.indexof.{@event.param2} gt 0)"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'player_owned_attacked_object'"/>
      <set_value name="$ev_att" exact="@event.param"/>
      <set_value name="$victim" exact="@event.param2"/>
      <set_value name="$comp" exact="@event.param2"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$p3_str" exact="'null'"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 8: Per-projectile player-occupied ship hit callback (global event: param=victim, param2=attacker, param3=projectile). -->
    <cue name="PlayerShipHit" instantiate="true" namespace="this">
     <conditions>
      <event_player_ship_hit/>
      <check_value value="State.$armed and State.$watch_player_ship"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'player_ship_hit'"/>
      <set_value name="$victim" exact="@event.param"/>
      <set_value name="$ev_att" exact="@event.param2"/>
      <set_value name="$comp" exact="@event.param"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3.macro.id]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 9: Destruction callback for watched targets. -->
    <cue name="ObjectDestroyed" instantiate="true" namespace="this">
     <conditions>
      <event_object_destroyed group="State.$targets"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <set_value name="$kind" exact="'object_destroyed'"/>
      <set_value name="$victim" exact="event.object"/>
      <set_value name="$ev_att" exact="@event.param"/>
      <set_value name="$comp" exact="event.object"/>
      <set_value name="$p2_str" exact="'%s'.[@event.param2]"/>
      <set_value name="$p3_str" exact="'%s'.[@event.param3]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>

    <!-- Event 10: Optional read-only weapon fire counter for watched weapons. -->
    <cue name="WeaponFired" instantiate="true" namespace="this">
     <conditions>
      <event_weapon_fired group="State.$weapons"/>
      <check_value value="State.$armed"/>
     </conditions>
     <actions>
      <set_value name="$w" exact="event.object"/>
      <set_value name="$ship" exact="@$w.object"/>
      <set_value name="$wcount" exact="if State.$weapon_counts.{$w}? then State.$weapon_counts.{$w} + 1 else 1"/>
      <set_value name="State.$weapon_counts.{$w}" exact="$wcount"/>
      <set_value name="$kind" exact="'weapon_fired'"/>
      <set_value name="$victim" exact="null"/>
      <set_value name="$ev_att" exact="$ship"/>
      <set_value name="$comp" exact="$w"/>
      <set_value name="$p2_str" exact="'%s'.[$wcount]"/>
      <set_value name="$p3_str" exact="'%s'.[@$w.macro.id]"/>
      <set_value name="$amount" exact="0"/>
      <include_actions ref="Emit"/>
     </actions>
    </cue>
   </cues>
  </cue>
 </cues>
</mdscript>
